# Copy to `/etc/default/taira-validator-container.compose.env` on the validator host.

TAIRA_CONTAINER_NAME=taira-validator-1
# Replace with the admitted authority-bound repository digest or image ID.
TAIRA_IMAGE=hyperledger/iroha@sha256:REPLACE_WITH_SIGNED_MANIFEST_DIGEST
TAIRA_RUNTIME_PROFILE=production
TAIRA_CONFIG_BUNDLE_PATH=/etc/iroha/taira-validator
TAIRA_STORAGE_PATH=/var/lib/iroha/taira-validator-1
TAIRA_KAGEMUSHA_ARTIFACT_PATH=/var/lib/iroha/taira-validator/kagemusha/v4
TAIRA_P2P_PORT=1337
TAIRA_TORII_PORT=18080
TAIRA_RUST_LOG=info
# Optional for local multi-container validation on a shared user-defined bridge.
# TAIRA_DOCKER_NETWORK=taira-localnet

# Optional when uncommenting the matching lines in `docker-compose.validator.yml`.
# TAIRA_GENESIS_PATH=/etc/iroha/taira-validator-1/genesis.json
# TAIRA_SIGNED_GENESIS_PATH=/etc/iroha/taira-validator-1/genesis.signed.nrt
# Also set [sorafs.gateway.site_bindings].path = "/config/sorafs_sites.json"
# in the config under TAIRA_CONFIG_BUNDLE_PATH before enabling this mount.
# TAIRA_SORAFS_SITE_BINDINGS_PATH=/etc/iroha/taira-validator-1/sorafs_sites.json
