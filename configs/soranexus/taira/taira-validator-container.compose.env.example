# Copy to `/etc/default/taira-validator-container.compose.env` on the validator host.

TAIRA_CONTAINER_NAME=taira-validator-1
TAIRA_IMAGE=hyperledger/iroha:taira-latest
TAIRA_CONFIG_PATH=/etc/iroha/taira-validator-1/config.toml
TAIRA_STORAGE_PATH=/var/lib/iroha/taira-validator-1
TAIRA_P2P_PORT=1337
TAIRA_TORII_PORT=18080
TAIRA_RUST_LOG=info

# Optional when uncommenting the matching lines in `docker-compose.validator.yml`.
# TAIRA_GENESIS_PATH=/etc/iroha/taira-validator-1/genesis.json
# TAIRA_SORAFS_SITE_BINDINGS_PATH=/etc/iroha/taira-validator-1/sorafs_sites.json
