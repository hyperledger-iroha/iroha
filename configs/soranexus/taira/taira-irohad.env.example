# Optional executable/genesis overrides for `taira-irohad.service`.
# The config bundle path is deliberately fixed in the unit so its strict
# config-to-asset binding cannot drift through this environment file.

IROHA_TAIRA_GENESIS=/opt/iroha/configs/soranexus/taira/genesis.json
IROHA_TAIRA_IROHAD_BIN=/usr/local/bin/iroha3d
IROHA_TAIRA_INROU_PREREQ_CHECK=/opt/iroha/configs/soranexus/taira/check_inrou_host_prereqs.sh
# If these state roots change, update the unit's matching preflight and
# ReadWritePaths entries at the same time.
KURA_STORE_DIR=/var/lib/iroha/taira-validator-1
SNAPSHOT_STORE_DIR=/var/lib/iroha/taira-validator-1/snapshot
