# Optional overrides for `taira-irohad.service`.
# Copy to `/etc/default/taira-irohad` on the validator host and adjust paths.

IROHA_TAIRA_CONFIG=/etc/iroha/taira-validator-1/config.toml
IROHA_TAIRA_GENESIS=/opt/iroha/configs/soranexus/taira/genesis.json
IROHA_TAIRA_INROU_PREREQ_CHECK=/opt/iroha/configs/soranexus/taira/check_inrou_host_prereqs.sh
