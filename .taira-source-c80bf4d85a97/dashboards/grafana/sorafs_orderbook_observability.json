{
  "title": "SoraFS Orderbook Observability",
  "uid": "sorafs-orderbook-observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "tags": [
    "sorafs",
    "orderbook"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(torii_sorafs_orderbook_finalized_projection_ready, cluster)",
        "refresh": 1,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ""
        }
      },
      {
        "name": "tier",
        "label": "Tier",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(torii_sorafs_orderbook_open_depth_gib, tier)",
        "refresh": 1,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Open Order Depth GiB",
      "id": 1,
      "datasource": "$datasource",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(torii_sorafs_orderbook_open_depth_gib{cluster=~\"$cluster\",tier=~\"$tier\"})",
          "legendFormat": "depth",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Settlement Backlog",
      "id": 2,
      "datasource": "$datasource",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(torii_sorafs_orderbook_settlement_backlog{cluster=~\"$cluster\"})",
          "legendFormat": "receipts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Escrow Runway",
      "id": 3,
      "datasource": "$datasource",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(torii_sorafs_orderbook_escrow_runway_seconds{cluster=~\"$cluster\"})",
          "legendFormat": "seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Finalized Projection Ready",
      "id": 4,
      "datasource": "$datasource",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(torii_sorafs_orderbook_finalized_projection_ready{cluster=~\"$cluster\"})",
          "legendFormat": "ready",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Order Flow",
      "id": 5,
      "datasource": "$datasource",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (event) (rate(torii_sorafs_orderbook_finalized_events_total{cluster=~\"$cluster\"}[5m]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Depth By Side And Tier",
      "id": 6,
      "datasource": "$datasource",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (side, tier) (torii_sorafs_orderbook_open_depth_gib{cluster=~\"$cluster\",tier=~\"$tier\"})",
          "legendFormat": "{{side}} {{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Matching Lag",
      "id": 7,
      "datasource": "$datasource",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(torii_sorafs_orderbook_matcher_lag_seconds{cluster=~\"$cluster\"})",
          "legendFormat": "matcher lag",
          "refId": "A"
        },
        {
          "expr": "max(torii_sorafs_orderbook_book_revision{cluster=~\"$cluster\"} - torii_sorafs_orderbook_matcher_scan_book_revision{cluster=~\"$cluster\"})",
          "legendFormat": "revision gap",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Settlement Health",
      "id": 8,
      "datasource": "$datasource",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(torii_sorafs_orderbook_settlement_backlog{cluster=~\"$cluster\"})",
          "legendFormat": "backlog",
          "refId": "A"
        },
        {
          "expr": "max(torii_sorafs_orderbook_oldest_settlement_age_seconds{cluster=~\"$cluster\"})",
          "legendFormat": "oldest age seconds",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API Error Ratio",
      "id": 9,
      "datasource": "$datasource",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(torii_sorafs_orderbook_api_requests_total{cluster=~\"$cluster\",outcome=\"error\"}[5m])) / clamp_min(sum by (route) (rate(torii_sorafs_orderbook_api_requests_total{cluster=~\"$cluster\"}[5m])), 0.000000001)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Finalized Projection",
      "id": 10,
      "datasource": "$datasource",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "min(torii_sorafs_orderbook_finalized_projection_height{cluster=~\"$cluster\"})",
          "legendFormat": "minimum height",
          "refId": "A"
        },
        {
          "expr": "max(torii_sorafs_orderbook_finalized_projection_height{cluster=~\"$cluster\"})",
          "legendFormat": "maximum height",
          "refId": "B"
        },
        {
          "expr": "max(time() - torii_sorafs_orderbook_finalized_projection_timestamp_seconds{cluster=~\"$cluster\"})",
          "legendFormat": "finalized age seconds",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ]
}
