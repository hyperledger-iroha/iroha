{
  "$schema": "https://grafana.com/docs/grafana/latest/dashboards/reference/json-model/",
  "title": "SoraFS Provider Admission Rollout",
  "uid": "sorafs-provider-admission",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": [
    "sorafs",
    "provider-admission"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "result",
        "label": "Result",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(torii_sorafs_admission_total, result)",
        "refresh": 1,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ""
        }
      },
      {
        "name": "reason",
        "label": "Reason",
        "type": "query",
        "datasource": "$datasource",
        "query": "label_values(torii_sorafs_admission_total{result=~\"$result\"}, reason)",
        "refresh": 1,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Admission Outcomes (5m)",
      "id": 1,
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum by (result) (rate(torii_sorafs_admission_total{result=~\"$result\", reason=~\"$reason\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Warning Ratio (5m)",
      "id": 2,
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(rate(torii_sorafs_admission_total{result=\"warn\", reason=~\"$reason\"}[5m])) / clamp_min(sum(rate(torii_sorafs_admission_total{reason=~\"$reason\"}[5m])), 1)",
          "legendFormat": "warn_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Rejection Reasons (5m)",
      "id": 3,
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum by (reason) (rate(torii_sorafs_admission_total{result=\"rejected\", reason=~\"$reason\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Refresh Debt (1h)",
      "id": 4,
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(increase(torii_sorafs_admission_total{result=\"rejected\", reason=\"stale\"}[1h]))",
          "legendFormat": "stale_rejections",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Missing Envelopes (10m)",
      "id": 5,
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(increase(torii_sorafs_admission_total{result=\"rejected\", reason=\"admission_missing\"}[10m]))",
          "legendFormat": "admission_missing",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Admission Reason Totals (15m)",
      "id": 6,
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum by (result, reason) (increase(torii_sorafs_admission_total{result=~\"$result\", reason=~\"$reason\"}[15m]))",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
