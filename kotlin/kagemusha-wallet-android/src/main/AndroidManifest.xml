<?xml version="1.0" encoding="utf-8"?>
<!--
  KAGEMUSHA wallet custody requires an empty backup and device-transfer set
  (spec §4.2; G2 design rev 2). These attributes merge into the host
  application. The host app must not override them with tools:replace and must
  not declare android:backupAgent: KagemushaWalletAndroidPlatformV1 refuses to
  create a wallet adapter when FLAG_ALLOW_BACKUP is set or a backup agent exists.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/kagemusha_wallet_v1_data_extraction_rules"
        android:fullBackupContent="@xml/kagemusha_wallet_v1_full_backup_content"
        tools:targetApi="31" />
</manifest>
