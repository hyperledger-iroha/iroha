<?xml version="1.0" encoding="utf-8"?>
<!--
  KAGEMUSHA wallet custody (API 30 and lower): the full-backup set is empty.
  android:allowBackup="false" already disables backup there; these rules keep
  the set empty even if that attribute were overridden. The host app must not
  replace them (spec §4.2; G2 design rev 2).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
