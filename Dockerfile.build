ARG IROHA_CI_BUILDER_IMAGE

# CI uses the host engine through its mounted socket; retain only client tools.
FROM ${IROHA_CI_BUILDER_IMAGE} AS docker-clients
RUN pacman -Syu docker docker-compose --noconfirm --disable-download-timeout && \
    install -d /out/licenses && \
    cp /usr/bin/docker /out/docker && \
    cp /usr/lib/docker/cli-plugins/docker-compose /out/docker-compose && \
    cp -a /usr/share/licenses/docker-compose /out/licenses/ && \
    pacman -Q > /out/docker-client-source-packages.txt

FROM ${IROHA_CI_BUILDER_IMAGE} AS buildx
RUN pacman -Syu ca-certificates curl git tar --noconfirm --disable-download-timeout
RUN case "$(uname -m)" in \
      x86_64) go_arch=amd64; go_sha=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40 ;; \
      aarch64) go_arch=arm64; go_sha=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49 ;; \
      *) exit 1 ;; \
    esac && \
    curl --fail --show-error --location --retry 3 "https://go.dev/dl/go1.27.3.linux-${go_arch}.tar.gz" --output /tmp/go.tar.gz && \
    printf '%s  /tmp/go.tar.gz\n' "$go_sha" | sha256sum --check --strict && \
    tar --extract --gzip --no-same-owner --file /tmp/go.tar.gz --directory /usr/local && \
    rm /tmp/go.tar.gz
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local CGO_ENABLED=0 GOFLAGS=-mod=readonly
RUN curl --fail --show-error --location --retry 3 \
      https://codeload.github.com/docker/buildx/tar.gz/refs/tags/v0.38.2 --output /tmp/buildx.tar.gz && \
    printf '%s  /tmp/buildx.tar.gz\n' 1d20ca3cec6438b008eb6e0805c4842d4e27447690b4150df607790ca75629c0 | sha256sum --check --strict && \
    mkdir /src && tar --extract --gzip --no-same-owner --strip-components=1 --file /tmp/buildx.tar.gz --directory /src && \
    rm /tmp/buildx.tar.gz
WORKDIR /src
# Preserve upstream application code; update the two vulnerable dependencies.
# The test patch requires rejection of the invalid IDNA input the old fixture accepted.
COPY scripts/ci_image_buildx.go.mod /src/go.mod
COPY scripts/ci_image_buildx.go.sum /src/go.sum
COPY scripts/ci_image_buildx-tests.patch /tmp/buildx-tests.patch
# Bind the context-free test patch to both complete source file hashes.
RUN printf '%s  policy/validate_test.go\n' 465fd2ede51fcbd7a7c1a5e1381b27d958c620b6b9d25ad6175ea2cdc60ed4eb | sha256sum --check --strict && \
    git apply --check --unidiff-zero /tmp/buildx-tests.patch && git apply --unidiff-zero /tmp/buildx-tests.patch && \
    printf '%s  policy/validate_test.go\n' d69975416b03cf120f97fcaedb262816cfc34116b585e0be802e8c64a9acccb2 | sha256sum --check --strict
RUN mkdir /out && \
    cp LICENSE /out/buildx-LICENSE && \
    go mod verify && \
    go list -deps ./cmd/buildx > /out/buildx-packages.txt && \
    SKIP_INTEGRATION_TESTS=1 go test ./... && \
    go build -trimpath -ldflags '-s -w -X github.com/docker/buildx/version.Version=v0.38.2-iroha.1 -X github.com/docker/buildx/version.Revision=v0.38.2-with-reviewed-module-lock' \
      -o /out/docker-buildx ./cmd/buildx && \
    go version -m /out/docker-buildx > /out/buildx-build-info.txt && \
    /out/docker-buildx version

FROM ${IROHA_CI_BUILDER_IMAGE}

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_TOOLCHAIN=1.99.1 \
    PATH=/usr/local/cargo/bin:$PATH \
    POETRY_HOME=/opt/poetry \
    TORII_API_PORT_MIN=8080 \
    TORII_API_PORT_MAX=8083

ENV PATH=$POETRY_HOME/bin:$PATH

RUN pacman -Syu rustup mold openssl libgit2 jq unzip curl ca-certificates tar bzip2 \
    git \
    python python-pip --noconfirm --disable-download-timeout && \
    install -d /usr/local/share/iroha-ci && \
    pacman -Q > /usr/local/share/iroha-ci/arch-packages.txt
COPY --from=docker-clients /out/licenses/ /usr/share/licenses/
COPY --from=buildx /out/buildx-LICENSE /usr/share/licenses/docker-buildx/LICENSE
COPY --from=docker-clients /out/docker /usr/bin/docker
COPY --from=docker-clients /out/docker-compose /usr/lib/docker/cli-plugins/docker-compose
COPY --from=docker-clients /out/docker-client-source-packages.txt /usr/local/share/iroha-ci/
COPY --from=buildx /out/docker-buildx /usr/lib/docker/cli-plugins/docker-buildx
COPY --from=buildx /out/buildx-packages.txt /out/buildx-build-info.txt /usr/local/share/iroha-ci/
RUN docker --version && docker buildx version && docker compose version && \
    ! command -v dockerd && ! command -v containerd && ! command -v ctr && \
    groupadd --system docker

RUN rustup toolchain install "$RUSTUP_TOOLCHAIN" --profile minimal \
    --component llvm-tools-preview --component clippy --component rust-src --component rustfmt && \
    rustup default "$RUSTUP_TOOLCHAIN"

# grcov 0.10.8 is an upstream release, but is not published to crates.io.
# Verify the official Linux release bytes before extracting either architecture.
RUN case "$(uname -m)" in \
      x86_64) grcov_arch=x86_64; grcov_sha=25ef3d08b660fe82cd7306dd5af4fa59aa7342718fe89d98ef95064c557e28ab ;; \
      aarch64) grcov_arch=aarch64; grcov_sha=c23533dbca2e1500ebbedc6d89b9926a5193faa772f849ade9291d5365af31e6 ;; \
      *) exit 1 ;; \
    esac && \
    curl --fail --show-error --location --retry 3 \
      "https://github.com/mozilla/grcov/releases/download/v0.10.8/grcov-${grcov_arch}-unknown-linux-gnu.tar.bz2" \
      --output /tmp/grcov.tar.bz2 && \
    printf '%s  /tmp/grcov.tar.bz2\n' "$grcov_sha" | sha256sum --check --strict && \
    mkdir /tmp/grcov && tar --extract --bzip2 --no-same-owner --file /tmp/grcov.tar.bz2 --directory /tmp/grcov && \
    install -d /usr/local/cargo/bin && \
    install -m 0755 /tmp/grcov/grcov /usr/local/cargo/bin/grcov && \
    grcov --version && rm -rf /tmp/grcov /tmp/grcov.tar.bz2

COPY scripts/ci_image_poetry.lock /tmp/ci_image_poetry.lock
RUN python3 -c 'import sys; assert sys.version_info[:2] == (3, 14), "CI Poetry lock requires Python 3.14"' && \
    python3 -m venv "$POETRY_HOME" && \
    "$POETRY_HOME/bin/python" -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/ci_image_poetry.lock && \
    "$POETRY_HOME/bin/python" -m pip check && \
    poetry --version && rm /tmp/ci_image_poetry.lock

ARG BUILDER_USER=iroha
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000

RUN groupadd --gid "${BUILDER_GID}" "${BUILDER_USER}" \
    && useradd --uid "${BUILDER_UID}" \
        --gid "${BUILDER_GID}" \
        --create-home \
        --shell /bin/bash \
        "${BUILDER_USER}" \
    && usermod --append --groups docker "${BUILDER_USER}" \
    && install -d -o "${BUILDER_USER}" -g "${BUILDER_USER}" /workspace \
    && chown -R "${BUILDER_USER}":"${BUILDER_USER}" \
        /usr/local/rustup \
        /usr/local/cargo \
        /opt/poetry

USER ${BUILDER_USER}
WORKDIR /workspace
ENV HOME=/home/${BUILDER_USER}
