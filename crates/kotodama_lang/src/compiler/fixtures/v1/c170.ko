
seiyaku Test {
  #[access(read="*", write="*")]
  kotoage fn move(AccountId from, AccountId to, AssetDefinitionId asset, quantity amount) authorize("Admin") {
    ledger::asset::transfer(
      source: from,
      destination: to,
      asset_definition: asset,
      amount: amount,
      dataspace: DataSpaceId::parse("0"),
    );
  }
}
