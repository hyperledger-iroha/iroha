
            seiyaku Demo {
                kotoage fn run(int count) -> int authorize("Entry") { return count + 1; }

                #[test]
                fn drive_run() {
                    let next = test::invoke_kotoage_as(
                        actor: "issuer",
                        kotoage: "run",
                        arguments: Json::parse("{\"count\": 7}"),
                    );
                    test::expect_reject_as(
                        actor: "issuer",
                        kotoage: "run",
                        arguments: Json::parse("{\"count\": -1}"),
                    );
                    let _ = next;
                }
            }
        