
            seiyaku Demo {
                kotoage fn run(int count) -> int authorize("Entry") { return count + 1; }

                #[test]
                fn drive_run() {
                    let next = test::invoke_kotoage(kotoage: "run", arguments: Json::parse("{\"count\": 7}"));
                    test::assert_eq(actual: next, expected: 8);
                }
            }
        