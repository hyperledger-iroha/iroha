// Minimal lending market primitives.
// Shows collateral ratio checks and minting borrowed asset.
seiyaku LendingSimple {
    error enum LendingError {
        InsufficientCollateral = 1,
    }

    // Compute collateralization ratio in basis points (bps = 1/100 of a percent).
    fn collateral_ratio_bps(collateral_value: Amount, debt_value: Amount) -> Amount {
        let zero = Amount::from_i64(0);
        if debt_value == zero {
            return Amount::from_i64(1_000_000);
        }
        // effectively infinite
        let bps_scale = Amount::from_i64(10_000);
        let ratio = (collateral_value * bps_scale) / debt_value;
        return ratio;
    }

    // Borrow after checking ratio >= min_ratio_bps.
    kotoage fn borrow(
        user: AccountId,
        _vault_account: AccountId,
        debt_asset: AssetDefinitionId,
        amount: Amount,
        collateral_value: Amount,
        current_debt_value: Amount,
        min_ratio_bps: Amount,
    ) authorize("Admin") {
        let new_debt_value = current_debt_value + amount;
        let ratio = collateral_ratio_bps(
            collateral_value: collateral_value,
            debt_value: new_debt_value,
        );
        require(ratio >= min_ratio_bps, LendingError::InsufficientCollateral);
        // Mint borrowed asset to user
        ledger::asset::mint(account: user, asset_definition: debt_asset, amount: amount);
    }

    // Repay by transferring tokens from user to vault and burning.
    kotoage fn repay(
        user: AccountId,
        vault_account: AccountId,
        debt_asset: AssetDefinitionId,
        amount: Amount,
    ) authorize("Admin") {
        ledger::asset::transfer(
            source: user,
            destination: vault_account,
            asset_definition: debt_asset,
            amount: amount,
            dataspace: DataSpaceId::parse("0"),
        );
        ledger::asset::burn(account: vault_account, asset_definition: debt_asset, amount: amount);
    }
}
