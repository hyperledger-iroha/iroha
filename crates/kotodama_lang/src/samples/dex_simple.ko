// Simple constant-product DEX helpers (no persistent state yet).
// Demonstrates arithmetic, conditionals, returns, and syscalls.
seiyaku DexSimple {
    // Quote output amount for selling `amount_in` of input into output reserves.
    fn quote_sell(quantity reserve_in, quantity reserve_out, quantity amount_in) -> quantity {
        // apply 0.3% fee
        let fee_numerator = 997;
        let fee_denominator = 1000;
        let effective = (amount_in * fee_numerator) / fee_denominator;
        let numerator = reserve_out * effective;
        let denominator = reserve_in + effective;
        let out = numerator / denominator;
        return out;
    }

    // Perform a swap by moving tokens between trader and a pool account.
    // In a full implementation, `pool_account` would be derived from seiyaku state.
    kotoage fn swap(
        AccountId trader,
        AccountId pool_account,
        AssetDefinitionId input_asset,
        AssetDefinitionId output_asset,
        quantity amount_in,
        quantity reserve_in,
        quantity reserve_out,
    ) -> quantity authorize("Admin") {
        let out = quote_sell(
            reserve_in: reserve_in,
            reserve_out: reserve_out,
            amount_in: amount_in,
        );
        // move input from trader to pool, and output from pool to trader
        ledger::asset::transfer(
            source: trader,
            destination: pool_account,
            asset_definition: input_asset,
            amount: amount_in,
            dataspace: DataSpaceId::parse("0"),
        );
        ledger::asset::transfer(
            source: pool_account,
            destination: trader,
            asset_definition: output_asset,
            amount: out,
            dataspace: DataSpaceId::parse("0"),
        );
        return out;
    }

    // Deterministic order id using a Poseidon hash of (trader, salt).
    kotoage fn order_id(int trader, int salt) -> int authorize("Entry") {
        let h = crypto::poseidon2(left: trader, right: salt);
        return h;
    }
}
