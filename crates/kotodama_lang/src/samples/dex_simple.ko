// Simple constant-product DEX helpers (no persistent state yet).
// Demonstrates arithmetic, conditionals, returns, and syscalls.
seiyaku DexSimple {
    // Quote output amount for selling `amount_in` of input into output reserves.
    fn quote_sell(reserve_in: Amount, reserve_out: Amount, amount_in: Amount) -> Amount {
        // apply 0.3% fee
        let fee_numerator = Amount::from_i64(997);
        let fee_denominator = Amount::from_i64(1000);
        let effective = (amount_in * fee_numerator) / fee_denominator;
        let numerator = reserve_out * effective;
        let denominator = reserve_in + effective;
        let out = numerator / denominator;
        return out;
    }

    // Perform a swap by moving tokens between trader and a pool account.
    // In a full implementation, `pool_account` would be derived from contract state.
    kotoage fn swap(trader: AccountId, pool_account: AccountId, input_asset: AssetDefinitionId, output_asset: AssetDefinitionId, amount_in: Amount, reserve_in: Amount, reserve_out: Amount) -> Amount authorize("Admin") {
        let out = quote_sell(reserve_in, reserve_out, amount_in);
        // move input from trader to pool, and output from pool to trader
        ledger::asset::transfer(trader, pool_account, input_asset, amount_in, DataSpaceId::parse("0"));
        ledger::asset::transfer(pool_account, trader, output_asset, out, DataSpaceId::parse("0"));
        return out;
    }

    // Deterministic order id using a Poseidon hash of (trader, salt).
    kotoage fn order_id(trader: i64, salt: i64) -> i64 authorize("Entry") {
        let h = crypto::poseidon2(trader, salt);
        return h;
    }
}
