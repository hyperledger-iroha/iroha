// Perpetual swap funding and simple liquidation check utilities.
seiyaku PerpFunding {
    // Compute an unsigned funding-payment magnitude. Direction is selected by
    // comparing mark and index prices before any checked subtraction.
    fn funding_payment(quantity position_size_magnitude, quantity price_delta, quantity funding_bps) -> quantity {
        let num = position_size_magnitude * price_delta * funding_bps;
        let pay = num / 10_000;
        return pay;
    }

    // Update position balance by transferring funding between the trader and
    // insurance fund. A mark premium makes the trader pay; a discount reverses
    // the transfer direction.
    kotoage fn settle_funding(
        AccountId trader,
        AccountId insurance_fund,
        AssetDefinitionId stable_asset,
        quantity position_size_magnitude,
        quantity mark_price,
        quantity index_price,
        quantity funding_bps,
    ) authorize("Admin") {
        if mark_price >= index_price {
            let premium_delta = mark_price - index_price;
            let premium_payment = funding_payment(
                position_size_magnitude: position_size_magnitude,
                price_delta: premium_delta,
                funding_bps: funding_bps,
            );
            ledger::asset::transfer(
                source: trader,
                destination: insurance_fund,
                asset_definition: stable_asset,
                amount: premium_payment,
                dataspace: DataSpaceId::parse("0"),
            );
        } else {
            let discount_delta = index_price - mark_price;
            let discount_payment = funding_payment(
                position_size_magnitude: position_size_magnitude,
                price_delta: discount_delta,
                funding_bps: funding_bps,
            );
            ledger::asset::transfer(
                source: insurance_fund,
                destination: trader,
                asset_definition: stable_asset,
                amount: discount_payment,
                dataspace: DataSpaceId::parse("0"),
            );
        }
    }

    // Basic liquidation check: equity_bps = (equity * 10_000) / notional
    view fn is_liquidatable(quantity equity, quantity notional, quantity maintenance_bps) -> bool {
        if notional == 0 {
            return false;
        }
        // not liquidatable if no position
        let equity_bps = (equity * 10_000) / notional;
        let liq = (equity_bps < maintenance_bps);
        return liq;
    }
}
