seiyaku AssetOps {
    kotoage fn execute() authorize("Admin") {
        // Typed pointer‑ABI arguments via constructors
        let alice = context::authority();
        let bob = context::authority();
        let coin = AssetDefinitionId::parse("6pEP9RjNoZ7beWkT3pLfKoM1dyfi");
        ledger::asset::mint(account: alice, asset_definition: coin, amount: Amount::from_i64(1000));
        ledger::asset::transfer(
            source: alice,
            destination: bob,
            asset_definition: coin,
            amount: Amount::from_i64(500),
            dataspace: DataSpaceId::parse("0"),
        );
        ledger::asset::burn(account: bob, asset_definition: coin, amount: Amount::from_i64(100));
    }
}
