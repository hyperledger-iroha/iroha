// Constant-product (XYK) DEX sample with basic pool lifecycle.
// Pools are keyed by a caller-provided `Name` so multiple pairs can coexist.
seiyaku IrohaSwap {
    error enum PoolError {
        UnknownPool = 1, IdenticalAssets = 2, PoolAlreadyExists = 3, InvalidAssetAAmount = 4, InvalidAssetBAmount = 5, ZeroLiquidityMinted = 6, InvalidLiquidityAmount = 7, EmptyPool = 8, ZeroAssetAOutput = 9, ZeroAssetBOutput = 10, InvalidSwapAmount = 11, AssetNotInPool = 12, SlippageExceeded = 13, InsufficientOutput = 14,
    }

    // Pool metadata
    state PoolAssetA: StateMap<Name, AssetDefinitionId>;
    state PoolAssetB: StateMap<Name, AssetDefinitionId>;
    state PoolAccount: StateMap<Name, AccountId>;
    state PoolLpAsset: StateMap<Name, AssetDefinitionId>;
    // Pool accounting (reserves and LP supply)
    state ReserveA: StateMap<Name, Amount>;
    state ReserveB: StateMap<Name, Amount>;
    state LpSupply: StateMap<Name, Amount>;
    fn min_value(a: Amount, b: Amount) -> Amount {
        if (a < b) {
            return a;
        } else {
            return b;
        }
    }

    fn ensure_pool(pool: Name) {
        require(PoolAssetA.contains(pool), PoolError::UnknownPool);
        require(PoolAssetB.contains(pool), PoolError::UnknownPool);
        require(PoolAccount.contains(pool), PoolError::UnknownPool);
        require(PoolLpAsset.contains(pool), PoolError::UnknownPool);
    }

    // Create a new pool with caller-chosen LP asset and pool account.
    kotoage fn init_pool(pool: Name, asset_a: AssetDefinitionId, asset_b: AssetDefinitionId, pool_account: AccountId, lp_asset: AssetDefinitionId) authorize("Admin") {
        let zero = Amount::from_i64(0);
        require(asset_a != asset_b, PoolError::IdenticalAssets);
        // Refuse re-init.
        require(!PoolAssetA.contains(pool), PoolError::PoolAlreadyExists);
        PoolAssetA[pool] = asset_a;
        PoolAssetB[pool] = asset_b;
        PoolAccount[pool] = pool_account;
        PoolLpAsset[pool] = lp_asset;
        ReserveA[pool] = zero;
        ReserveB[pool] = zero;
        LpSupply[pool] = zero;
        debug::info("pool_initialized");
    }

    // Provide liquidity; mints LP proportional to contribution.
    kotoage fn deposit_liquidity(provider: AccountId, pool: Name, amount_a: Amount, amount_b: Amount) authorize("Admin") {
        let zero = Amount::from_i64(0);
        require(amount_a > zero, PoolError::InvalidAssetAAmount);
        require(amount_b > zero, PoolError::InvalidAssetBAmount);
        ensure_pool(pool);
        let asset_a = PoolAssetA.get(pool).unwrap_or(AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM"));
        let asset_b = PoolAssetB.get(pool).unwrap_or(AssetDefinitionId::parse("6pEP9RjNoZ7beWkT3pLfKoM1dyfi"));
        let pool_account = PoolAccount.get(pool).unwrap_or(provider);
        let lp_asset = PoolLpAsset.get(pool).unwrap_or(asset_a);
        let reserve_a = ReserveA.ensure(pool, zero);
        let reserve_b = ReserveB.ensure(pool, zero);
        let total_lp = LpSupply.ensure(pool, zero);
        let minted = (total_lp == zero)?min_value(amount_a, amount_b): min_value((amount_a * total_lp) / reserve_a, (amount_b * total_lp) / reserve_b);
        require(minted > zero, PoolError::ZeroLiquidityMinted);
        // Move tokens into the pool account.
        ledger::asset::transfer(provider, pool_account, asset_a, amount_a, DataSpaceId::parse("0"));
        ledger::asset::transfer(provider, pool_account, asset_b, amount_b, DataSpaceId::parse("0"));
        // Mint LP tokens to the provider.
        ledger::asset::mint(provider, lp_asset, minted);
        ReserveA[pool] = reserve_a + amount_a;
        ReserveB[pool] = reserve_b + amount_b;
        LpSupply[pool] = total_lp + minted;
    }

    // Withdraw liquidity; burns LP and returns proportional reserves.
    kotoage fn withdraw_liquidity(provider: AccountId, pool: Name, lp_amount: Amount) authorize("Admin") {
        let zero = Amount::from_i64(0);
        require(lp_amount > zero, PoolError::InvalidLiquidityAmount);
        ensure_pool(pool);
        let asset_a = PoolAssetA.get(pool).unwrap_or(AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM"));
        let asset_b = PoolAssetB.get(pool).unwrap_or(AssetDefinitionId::parse("6pEP9RjNoZ7beWkT3pLfKoM1dyfi"));
        let pool_account = PoolAccount.get(pool).unwrap_or(provider);
        let lp_asset = PoolLpAsset.get(pool).unwrap_or(asset_a);
        let reserve_a = ReserveA.ensure(pool, zero);
        let reserve_b = ReserveB.ensure(pool, zero);
        let total_lp = LpSupply.ensure(pool, zero);
        require(total_lp > zero, PoolError::EmptyPool);
        let amount_a = (lp_amount * reserve_a) / total_lp;
        let amount_b = (lp_amount * reserve_b) / total_lp;
        require(amount_a > zero, PoolError::ZeroAssetAOutput);
        require(amount_b > zero, PoolError::ZeroAssetBOutput);
        ledger::asset::burn(provider, lp_asset, lp_amount);
        ledger::asset::transfer(pool_account, provider, asset_a, amount_a, DataSpaceId::parse("0"));
        ledger::asset::transfer(pool_account, provider, asset_b, amount_b, DataSpaceId::parse("0"));
        ReserveA[pool] = reserve_a - amount_a;
        ReserveB[pool] = reserve_b - amount_b;
        LpSupply[pool] = total_lp - lp_amount;
    }

    // Swap with 0.3% fee (997/1000).
    kotoage fn swap(trader: AccountId, pool: Name, input_asset: AssetDefinitionId, amount_in: Amount, min_output: Amount) -> Amount authorize("Admin") {
        let zero = Amount::from_i64(0);
        require(amount_in > zero, PoolError::InvalidSwapAmount);
        ensure_pool(pool);
        let asset_a = PoolAssetA.get(pool).unwrap_or(AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM"));
        let asset_b = PoolAssetB.get(pool).unwrap_or(AssetDefinitionId::parse("6pEP9RjNoZ7beWkT3pLfKoM1dyfi"));
        let pool_account = PoolAccount.get(pool).unwrap_or(trader);
        let reserve_a = ReserveA.ensure(pool, zero);
        let reserve_b = ReserveB.ensure(pool, zero);
        let is_a_in = input_asset == asset_a;
        let is_b_in = input_asset == asset_b;
        require(is_a_in || is_b_in, PoolError::AssetNotInPool);
        let reserve_in = (is_a_in)?reserve_a: reserve_b;
        let reserve_out = (is_a_in)?reserve_b: reserve_a;
        let fee_numerator = Amount::from_i64(997);
        let fee_denominator = Amount::from_i64(1000);
        let effective = (amount_in * fee_numerator) / fee_denominator;
        let out = (reserve_out * effective) / (reserve_in + effective);
        require(out >= min_output, PoolError::SlippageExceeded);
        require(out > zero, PoolError::InsufficientOutput);
        if (is_a_in) {
            ReserveA[pool] = reserve_in + amount_in;
            ReserveB[pool] = reserve_out - out;
            ledger::asset::transfer(trader, pool_account, asset_a, amount_in, DataSpaceId::parse("0"));
            ledger::asset::transfer(pool_account, trader, asset_b, out, DataSpaceId::parse("0"));
        } else {
            ReserveB[pool] = reserve_in + amount_in;
            ReserveA[pool] = reserve_out - out;
            ledger::asset::transfer(trader, pool_account, asset_b, amount_in, DataSpaceId::parse("0"));
            ledger::asset::transfer(pool_account, trader, asset_a, out, DataSpaceId::parse("0"));
        }
        return out;
    }
}
