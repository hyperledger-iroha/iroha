// Domain operations sample (Kotodama).
// Demonstrates domain builtins using pointer constructors and CoreHost bridging.
seiyaku DomainOps {
    kotoage fn run() authorize("Admin") {
        // Register a new domain by id
        let domain_id = DomainId::parse("wonder.universal");
        ledger::domain::register(domain_id);
        // Transfer domain ownership from the current context::authority(demo no-op self transfer).
        ledger::domain::transfer(context::authority(), domain_id, context::authority());
        // Optionally unregister the domain (for demo purposes)
        ledger::domain::unregister(domain_id);
    }
}
