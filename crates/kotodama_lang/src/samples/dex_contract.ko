// Minimal DEX helpers using supported syntax.
seiyaku DexContract {
    fn quote_sell(reserve_in: Amount, reserve_out: Amount, amount_in: Amount) -> Amount {
        let fee_numerator = Amount::from_i64(997);
        let fee_denominator = Amount::from_i64(1000);
        let effective = (amount_in * fee_numerator) / fee_denominator;
        let num = reserve_out * effective;
        let den = reserve_in + effective;
        return num / den;
    }

    kotoage fn swap(
        trader: AccountId,
        pool: AccountId,
        input_asset: AssetDefinitionId,
        output_asset: AssetDefinitionId,
        amount_in: Amount,
        reserve_in: Amount,
        reserve_out: Amount,
    ) -> Amount authorize("Admin") {
        let out = quote_sell(
            reserve_in: reserve_in,
            reserve_out: reserve_out,
            amount_in: amount_in,
        );
        ledger::asset::transfer(
            source: trader,
            destination: pool,
            asset_definition: input_asset,
            amount: amount_in,
            dataspace: DataSpaceId::parse("0"),
        );
        ledger::asset::transfer(
            source: pool,
            destination: trader,
            asset_definition: output_asset,
            amount: out,
            dataspace: DataSpaceId::parse("0"),
        );
        return out;
    }
}
