// Tuple return and destructuring demo.
seiyaku TupleReturnDemo {
    fn pair(a: i64, b: i64) -> (i64, i64) {
        let t = (a + 1, b + 1);
        return t;
    }

    kotoage fn compute() -> (i64, i64) authorize("Entry") {
        let p = pair(3, 5);
        // Destructure using numeric field access
        return (p.0, p.1);
    }
}
