// Demonstrates the intended flow for shielded voting and unshield operations
// using Kotodama ZK intrinsics followed by the vendor bridge to enqueue ISIs.
//
// These intrinsics lower to IVM syscalls with strict pointer‑ABI:
//   - `ledger::governance::verify_ballot(...)` verifies ballot proofs.
//   - `crypto::zk::verify_unshield(...)` verifies unshield proofs.
//   - operation-specific submit helpers reject mismatched instruction kinds.
//
// Note: This sample uses string literals and inline builders to construct
// bytes/NoritoBytes pointers for illustration. Real clients should prepare
// proper Norito TLVs (envelopes and InstructionBox bytes) and may preload them
// into INPUT.
seiyaku ZkVoteAndUnshield {
    // Verify a ballot proof, then enqueue a prebuilt SubmitBallot instruction via the vendor bridge.
    fn verify_and_submit_ballot(proof_env: bytes, submit: bytes) {
        // 1) Verify the ballot using ZK_VOTE_VERIFY_BALLOT.
        //    `proof_env` must be a Norito-encoded OpenVerifyEnvelope in a NoritoBytes TLV.
        ledger::governance::verify_ballot(proof_env);
        // 2) Enqueue the prebuilt SubmitBallot InstructionBox.
        ledger::governance::submit_ballot(submit);
    }

    // Verify an unshield proof, then enqueue a prebuilt Unshield instruction via the vendor bridge.
    fn verify_and_unshield(proof_env: bytes, unshield: bytes) {
        // 1) Verify the unshield using ZK_VERIFY_UNSHIELD (0x61).
        crypto::zk::verify_unshield(proof_env);
        // 2) Enqueue the prebuilt Unshield instruction.
        crypto::zk::submit_unshield(unshield);
    }

    // Optional demo entrypoint: verifies and enqueues both operations using literal data.
    // The vendor bridge and unshield flow are privileged, so kotoage functions
    // that reach them must declare a permission tag.
    kotoage fn demo() authorize("Admin") {
        // Mock envelope bytes (opaque here); in practice, pass a Norito-encoded OpenVerifyEnvelope.
        let env_ballot = b"ENV-BALLOT";
        let env_unshield = b"ENV-UNSHIELD";
        let nullifier = b"0123456789abcdef0123456789abcdef";
        let proof = b"proof-bytes";
        let vk = b"vk-bytes";
        // Inline builders require literal inputs; for runtime data, prebuild
        // the Norito InstructionBox and pass it as a bytes/NoritoBytes pointer.
        let submit = ledger::governance::build_submit_ballot("election-1", b"ciphertext", nullifier, "halo2/ipa", proof, vk);
        verify_and_submit_ballot(env_ballot, submit);
        // `context::authority()` is runtime data, so the inline builder sample uses a
        // compile-time recipient literal instead.
        let recipient = AccountId::parse("sorauﾛ1Npﾃﾕヱﾇq11pｳﾘ2ｱ5ﾇｦiCJKjRﾔzｷNMNﾆｹﾕPCｳﾙFvｵE9LBLB");
        let unshield = crypto::zk::build_unshield(AssetDefinitionId::parse("6pEP9RjNoZ7beWkT3pLfKoM1dyfi"), recipient, 1, nullifier, "halo2/ipa", proof, vk);
        verify_and_unshield(env_unshield, unshield);
    }
}
