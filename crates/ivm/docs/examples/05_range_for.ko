// Compiler-proven bounded range loop within a contract.
seiyaku RangeFor {
    kotoage fn sum_to(n: i64) -> i64 authorize("Entry") {
        var acc = 0;
        for i in range(64) {
            if i >= n {
                break;
            }
            acc = acc + i;
        }
        return acc;
    }
}
