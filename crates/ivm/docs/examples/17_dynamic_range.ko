// Dynamic range(start, end) example for durable state maps.
// Semantics: iterate entries in [start, end). The compiler inserts runtime
// guards and lowers at most 64 deterministic iterations.
// Dynamic bounds are supported on state maps.

seiyaku DynamicRange {
  state Entries: Map<int, int>;

  kotoage fn bounded_range_sum(start: int, end: int) -> int {
    let acc = 0;
    for (k, v) in Entries.range(start, end) {
      acc = acc + v;
    }
    return acc;
  }
}
