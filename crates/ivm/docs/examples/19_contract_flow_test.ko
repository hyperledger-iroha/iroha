seiyaku ContractFlowExample {
    error enum ExampleError {
        Rejected = 1,
    }

    state counter: i64;
    state last_actor: AccountId;
    hajimari() {
        counter = 1;
        last_actor = context::authority();
    }

    kotoage fn increment() authorize("Entry") {
        counter = counter + 4;
    }

    kotoage fn remember_caller() authorize("Entry") {
        last_actor = context::authority();
    }

    kotoage fn reject_me() authorize("Entry") {
        require(false, ExampleError::Rejected);
    }
}
