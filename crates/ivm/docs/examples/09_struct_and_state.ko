// Demonstrates struct declaration and durable state.
seiyaku StructAndState {
    struct Pair {
        first: i64, second: i64
    }

    state stored_pair: Pair;
    hajimari() {
        stored_pair = Pair(0, 0);
    }

    kotoage fn set_pair(a: i64, b: i64) authorize("Entry") {
        stored_pair = Pair(a, b);
        debug::info("pair set");
    }
}
