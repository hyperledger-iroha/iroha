// Demonstrates an opcode whose required header capability is derived by the
// compiler. ABI v1, vector width, and cycle limits are build/runtime policy;
// seiyaku source cannot override them.
seiyaku MetaDemo {
    // hajimari/始まり hook staged by the runtime at activation.
    hajimari() {
        // Full-width hash syscalls are source-visible; scalar proof-gadget
        // opcodes are intentionally internal.
        let _digest = crypto::iroha_hash(b"meta-demo");
        let a = 1;
    }
}
