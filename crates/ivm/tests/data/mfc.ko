// Operations for Makoto Free Cash (MFC) token.
// Provides a simple transfer function and a looped
// transfer across a range of quantities.
seiyaku MakotoFreeCash {
    fn send_mfc(from_account: AccountId, to_account: AccountId, amount: Amount) {
        // Use constant asset id 1 representing the Makoto Free Cash token
        let mfc = mfc_asset();
        ledger::asset::transfer(from_account, to_account, mfc, amount, DataSpaceId::parse("0"));
    }

    fn loop_mfc(from_account: AccountId, to_account: AccountId) {
        let mfc = mfc_asset();
        var qty: Amount = Amount::from_i64(369);
        for _offset in range(64) {
            ledger::asset::transfer(from_account, to_account, mfc, qty, DataSpaceId::parse("0"));
            qty = qty + Amount::from_i64(1);
        }
    }

    // Example entry routine demonstrating asset creation and usage.
    // It first registers the Makoto Free Cash asset, mints some
    // quantity to the caller, then performs the transfers.
    kotoage fn main(from: AccountId, to: AccountId) authorize("ManageMfc") {
        // Register the asset definition before minting any tokens.
        let mfc = mfc_asset();
        ledger::asset::register(mfc, "MFC", 0, 1);
        ledger::asset::mint(from, mfc, Amount::from_i64(1337));
        let dest = to;
        send_mfc(from, dest, Amount::from_i64(369));
        loop_mfc(from, dest);
    }

    fn mfc_asset() -> AssetDefinitionId {
        let mfc = AssetDefinitionId::parse("62Fk4FPcMuLvW5QjDGNF2a4jAmjM");
        return mfc;
    }
}
