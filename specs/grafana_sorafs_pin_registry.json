{
  "$schema": "https://grafana.com/docs/grafana/latest/dashboards/reference/json-model/",
  "title": "SoraFS Pin Registry Overview",
  "timezone": "",
  "editable": false,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Retained Pin Lifecycle Records",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "torii_sorafs_pin_retained_manifests",
          "legendFormat": "retained records"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Live Pinned Content Bytes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "torii_sorafs_pin_live_content_bytes",
          "legendFormat": "live bytes"
        }
      ]
    }
  ]
}
