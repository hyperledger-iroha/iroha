{
  "RawGenesisTransaction": {
    "Struct": [
      { "name": "chain", "type": "ChainId" },
      { "name": "chain_discriminant", "type": "u16" },
      { "name": "executor", "type": "Option<String>" },
      { "name": "ivm_dir", "type": "String" },
      { "name": "transactions", "type": "Vec<RawGenesisTx>" },
      { "name": "consensus_mode", "type": "SumeragiConsensusMode" },
      { "name": "wire_protocol_version", "type": "u32" },
      { "name": "consensus_fingerprint", "type": "Option<String>" },
      { "name": "sumeragi_v2", "type": "SumeragiV2GenesisContextParameters" },
      {
        "name": "kagemusha_mint_finality",
        "type": "KagemushaMintFinalityGenesisParametersV1"
      },
      { "name": "crypto", "type": "ManifestCrypto" }
    ],
    "docs": "Canonical first-release raw genesis manifest. Both signed consensus-authority fields are mandatory."
  },
  "SumeragiV2GenesisContextParameters": {
    "Struct": [
      { "name": "da_layout", "type": "DataAvailabilityLayout" },
      { "name": "nexus_amx_context_hash", "type": "[u8; 32]" },
      { "name": "execution_policy_hash", "type": "[u8; 32]" }
    ],
    "docs": "Required signed Sumeragi v2 height-context transport and execution-policy parameters."
  },
  "KagemushaMintFinalityGenesisParametersV1": {
    "Struct": [
      {
        "name": "epoch_roster",
        "type": "KagemushaMintFinalityEpochRosterTemplateV1"
      },
      {
        "name": "next_epoch_roster",
        "type": "Option<KagemushaMintFinalityEpochRosterTemplateV1>"
      }
    ],
    "docs": "Required signed network-independent KAGEMUSHA mint-finality authority. The epoch-zero roster is mandatory; next_epoch_roster must be present and is non-null exactly when NPoS height one is an epoch boundary."
  },
  "KagemushaMintFinalityEpochRosterTemplateV1": {
    "Struct": [
      { "name": "version", "type": "u16" },
      { "name": "epoch", "type": "u64" },
      {
        "name": "validators",
        "type": "Vec<KagemushaMintFinalityValidatorKeysV1>"
      }
    ],
    "docs": "Strictly ordered exact 3f + 1 consensus/Pasta public-key roster for one epoch."
  },
  "KagemushaMintFinalityValidatorKeysV1": {
    "Struct": [
      { "name": "validator", "type": "PeerId" },
      { "name": "eq_proof_public_key", "type": "[u8; 32]" },
      { "name": "ep_proof_public_key", "type": "[u8; 32]" }
    ],
    "docs": "Consensus validator identity plus separately provisioned canonical compressed Pasta public keys."
  },
  "RawGenesisTx": {
    "Struct": [
      { "name": "parameters", "type": "Option<Parameters>" },
      { "name": "instructions", "type": "Vec<InstructionBox>" },
      { "name": "ivm_triggers", "type": "Vec<GenesisIvmTrigger>" },
      { "name": "topology", "type": "Vec<TopologyEntry>" }
    ]
  },
  "TopologyEntry": {
    "Struct": [
      {
        "name": "peer",
        "type": "PeerId",
        "docs": "Peer entry."
      },
      {
        "name": "pop_hex",
        "type": "HexString",
        "docs": "Proof-of-possession hex (lowercase, without 0x)."
      }
    ],
    "docs": "Entries are objects with `peer` and `pop_hex` to keep PoPs adjacent to peers."
  },
  "ManifestCrypto": {
    "Struct": [
      { "name": "sm_openssl_preview", "type": "bool" },
      { "name": "default_hash", "type": "String" },
      { "name": "allowed_signing", "type": "Vec<Algorithm>" },
      { "name": "sm2_distid_default", "type": "String" },
      { "name": "allowed_curve_ids", "type": "Vec<u8>" }
    ]
  }
}
