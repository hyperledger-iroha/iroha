+            Option<iroha_primitives::numeric::Quantity>,
+        >(super::read_aos_field(bytes, &mut offset, flags)?, flags)?;
+        if offset != bytes.len() {
+            return Err(norito::core::Error::LengthMismatch);
+        }
+        norito::core::note_payload_access(bytes, offset);
+        Ok((
+            Self {
+                account_id,
+                asset_definition_id,
+                holding_limit,
+            },
+            offset,
+        ))
+    }
