+        }
+        if record.conditions.iter().any(|state| {
+            matches!(
+                &state.condition,
+                AssetLockCondition::Oracle(condition)
+                    if condition.sequence < sequence && state.satisfied_at_ms.is_none()
+            )
+        }) {
+            return Err(validation_err(
+                "asset lock oracle conditions must be attested in sequence",
+            ));
+        }
+        let predicate_satisfied = match (&predicate, &self.value) {
+            (AssetLockPredicate::TextEquals(expected), AssetLockAttestationValue::Text(actual)) => {
+                actual == expected
+            }
+            (
+                AssetLockPredicate::QuantityAtMost(maximum),
+                AssetLockAttestationValue::Quantity(actual),
+            ) => actual <= maximum,
+            _ => false,
+        };
+        if !predicate_satisfied {
+            return Err(validation_err(
+                "asset lock attestation value does not satisfy its typed predicate",
+            ));
+        }
+
+        record.conditions[condition_index].attestation = Some(AssetLockAttestation {
+            attestor: authority.clone(),
+            value: self.value,
+            evidence_hash: self.evidence_hash,
+            committed_at_ms: now_ms,
+        });
+        record.conditions[condition_index].satisfied_at_ms = Some(now_ms);
+
+        let all_oracles_satisfied = record.conditions.iter().all(|state| {
+            matches!(&state.condition, AssetLockCondition::Within(_))
+                || state.satisfied_at_ms.is_some()
+        });
+        if all_oracles_satisfied {
+            for state in &mut record.conditions {
+                if matches!(&state.condition, AssetLockCondition::Within(_)) {
+                    state.satisfied_at_ms = Some(now_ms);
+                }
+            }
+        }
+        let automatically_released = record
+            .conditions
+            .iter()
+            .all(|state| state.satisfied_at_ms.is_some());
+        if automatically_released {
+            let destination = record
+                .buyer
+                .clone()
+                .ok_or_else(|| validation_err("lock destination missing"))?;
+            let custody_asset = custody_asset(&record);
+            let destination_asset = party_asset(&record, &destination);
+            let delta = transfer_numeric_asset_for_escrow(
+                state_transaction,
+                &custody_asset,
+                &destination_asset,
+                &record.remaining_amount,
+                NumericAssetTransferSourcePolicy::NativeEscrowCustody,
+            )?;
+            state_transaction.record_transfer_transcript(authority, delta)?;
+            record.remaining_amount = Quantity::zero();
+            record.status = AssetEscrowStatus::Released;
+            record.closed_at_ms = Some(now_ms);
+        }
+        state_transaction
+            .world
+            .insert_asset_escrow_entry(record.clone());
+        state_transaction
+            .world
+            .emit_events(Some(EscrowEvent::Attested(AssetEscrowAttested {
+                escrow: record.clone(),
+                condition_id: self.condition_id,
+                attestor: authority.clone(),
+                automatically_released,
+            })));
+        if automatically_released {
+            state_transaction
+                .world
+                .emit_events(Some(EscrowEvent::Released(record)));
+        }
+        Ok(())
+    }
+}
