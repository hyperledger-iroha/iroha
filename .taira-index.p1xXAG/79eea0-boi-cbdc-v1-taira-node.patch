+#[cfg(feature = "app_api")]
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct ContractStateIdentity {
+    contract_subject_account: String,
+    code_hash_hex: String,
+    abi_hash_hex: String,
+    public_entrypoints: Vec<String>,
+}
+
+#[cfg(feature = "app_api")]
+fn contract_state_identity_error(message: impl Into<String>) -> Error {
+    Error::AppConflict {
+        code: "contract_state_identity_invalid",
+        message: message.into(),
+    }
+}
+
+#[cfg(feature = "app_api")]
+fn resolve_contract_state_identity(
+    world: &impl WorldReadOnly,
+    contract_address: &iroha_data_model::smart_contract::ContractAddress,
+) -> Result<ContractStateIdentity> {
+    let subject = iroha_core::smartcontracts::code::bound_contract_subject_from_world(
+        world,
+        contract_address,
+    )
+    .ok_or_else(|| {
+        contract_state_identity_error(format!(
+            "contract `{contract_address}` has no active canonical subject binding"
+        ))
+    })?;
+    if world.contract_subject_addresses().get(&subject) != Some(contract_address) {
+        return Err(contract_state_identity_error(format!(
+            "contract `{contract_address}` subject reverse binding is missing or inconsistent"
+        )));
+    }
+
+    let code_hash = world
+        .contract_instances()
+        .get(contract_address)
+        .copied()
+        .ok_or_else(|| {
+            contract_state_identity_error(format!(
+                "contract `{contract_address}` has no active code binding"
+            ))
+        })?;
+    let manifest = world.contract_manifests().get(&code_hash).ok_or_else(|| {
+        contract_state_identity_error(format!(
+            "contract `{contract_address}` active code has no committed manifest"
+        ))
+    })?;
+    if manifest.code_hash != Some(code_hash) {
+        return Err(contract_state_identity_error(format!(
+            "contract `{contract_address}` manifest does not commit its active code hash"
+        )));
+    }
+    let abi_hash = manifest.abi_hash.ok_or_else(|| {
+        contract_state_identity_error(format!(
+            "contract `{contract_address}` manifest does not commit an ABI hash"
+        ))
+    })?;
+
+    let mut all_entrypoints = BTreeSet::new();
+    let mut public_entrypoints = BTreeSet::new();
+    for descriptor in manifest.entrypoints.as_deref().unwrap_or_default() {
+        if !all_entrypoints.insert(descriptor.name.as_str()) {
+            return Err(contract_state_identity_error(format!(
+                "contract `{contract_address}` manifest contains duplicate entrypoint `{}`",
+                descriptor.name
+            )));
+        }
+        if matches!(
+            descriptor.kind,
+            manifest::EntryPointKind::Kotoage | manifest::EntryPointKind::View
+        ) {
+            public_entrypoints.insert(descriptor.name.clone());
+        }
+    }
+
+    Ok(ContractStateIdentity {
+        contract_subject_account: subject.to_string(),
+        code_hash_hex: hex::encode(code_hash.as_ref()),
+        abi_hash_hex: hex::encode(abi_hash.as_ref()),
+        public_entrypoints: public_entrypoints.into_iter().collect(),
+    })
+}
