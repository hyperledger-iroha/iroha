 }
 
+/// Typed value supplied by an oracle when attesting an asset-lock condition.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Decode, Encode, IntoSchema)]
+#[cfg_attr(
+    feature = "json",
+    derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)
+)]
+#[cfg_attr(feature = "json", norito(tag = "kind", content = "value"))]
+pub enum AssetLockAttestationValue {
+    /// Exact UTF-8 text, such as a processor model.
+    Text(String),
+    /// Non-negative numeric value, such as a delivery-day count.
+    Quantity(Quantity),
+}
+
+/// Predicate evaluated against a typed oracle attestation.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Decode, Encode, IntoSchema)]
+#[cfg_attr(
+    feature = "json",
+    derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)
+)]
+#[cfg_attr(feature = "json", norito(tag = "kind", content = "value"))]
+pub enum AssetLockPredicate {
+    /// Require exact text equality.
+    TextEquals(String),
+    /// Require a numeric value no greater than this bound.
+    QuantityAtMost(Quantity),
+}
+
+/// Oracle predicate configuration for a native conditional asset lock.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Decode, Encode, IntoSchema)]
+#[cfg_attr(
+    feature = "json",
+    derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)
+)]
+pub struct AssetLockOracleCondition {
+    /// Caller-selected condition identifier.
+    pub id: String,
+    /// Account authorized to attest this condition.
+    pub attestor: AccountId,
+    /// Predicate evaluated against the attested value.
+    pub predicate: AssetLockPredicate,
+    /// One-based priority sequence. Lower values must attest first.
+    pub sequence: u32,
+}
+
+/// Time-window configuration for a native conditional asset lock.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Decode, Encode, IntoSchema)]
+#[cfg_attr(
+    feature = "json",
+    derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)
+)]
+pub struct AssetLockWithinCondition {
+    /// Caller-selected condition identifier.
+    pub id: String,
+    /// Allowed duration in milliseconds from committed lock creation time.
+    pub duration_ms: u64,
+}
+
+/// One first-class condition on a native conditional asset lock.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Decode, Encode, IntoSchema)]
+#[cfg_attr(
+    feature = "json",
+    derive(crate::DeriveJsonSerialize, crate::DeriveJsonDeserialize)
+)]
+#[cfg_attr(feature = "json", norito(tag = "kind", content = "value"))]
+pub enum AssetLockCondition {
+    /// Oracle-signed predicate, optionally ordered relative to other oracle predicates.
+    Oracle(AssetLockOracleCondition),
+    /// Require every oracle attestation to commit within this duration from lock creation.
+    Within(AssetLockWithinCondition),
+}
+
+impl AssetLockCondition {
+    /// Return the caller-selected condition identifier.
+    #[must_use]
+    pub fn id(&self) -> &str {
+        match self {
+            Self::Oracle(condition) => &condition.id,
+            Self::Within(condition) => &condition.id,
+        }
+    }
+}
+
+/// Consensus-bound evidence for a satisfied oracle condition.
