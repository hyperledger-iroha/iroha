+fn ensure_asset_transfer_capability_runtime_scope(
+    state_transaction: &StateTransaction<'_, '_>,
+    authority: &AccountId,
+    instruction: &InstructionBox,
+    runtime_context: Option<&ContractRuntimeExecutionContext>,
+) -> Result<(), ValidationFail> {
+    let Some(execute) = instruction
+        .as_any()
+        .downcast_ref::<iroha_data_model::isi::ExecuteAssetTransferCapabilityV1>()
+    else {
+        return Ok(());
+    };
+    let Some(record) = state_transaction
+        .world
+        .asset_transfer_capabilities()
+        .get(&execute.capability_id)
+    else {
+        // The Core handler returns the canonical missing-record execution error.
+        return Ok(());
+    };
+    if &record.delegate != authority {
+        return Err(ValidationFail::NotPermitted(
+            "only the exact asset-transfer capability delegate may execute it".to_owned(),
+        ));
+    }
+
+    match (&record.contract_scope, runtime_context) {
+        (None, None) => {
+            if state_transaction
+                .world
+                .contract_subject_addresses()
+                .get(authority)
+                .is_some()
+            {
+                return Err(ValidationFail::NotPermitted(
+                    "historical contract subjects require an exact contract-scoped asset-transfer capability"
+                        .to_owned(),
+                ));
+            }
+        }
+        (None, Some(_)) => {
+            return Err(ValidationFail::NotPermitted(
+                "contract execution cannot consume an unscoped asset-transfer capability"
+                    .to_owned(),
+            ));
+        }
+        (Some(_), None) => {
+            return Err(ValidationFail::NotPermitted(
+                "contract-scoped asset-transfer capability requires proved contract execution"
+                    .to_owned(),
+            ));
+        }
+        (Some(scope), Some(context)) => {
+            let live_code_hash = state_transaction
+                .world
+                .contract_instances()
+                .get(&scope.contract_address);
+            if context.contract_subject != *authority
+                || context.contract_address != scope.contract_address
+                || context.entrypoint != scope.entrypoint
+                || scope.contract_address.subject_id() != *authority
+                || state_transaction
+                    .world
+                    .contract_subject_addresses()
+                    .get(authority)
+                    != Some(&scope.contract_address)
+                || live_code_hash != Some(&scope.code_hash)
+            {
+                return Err(ValidationFail::NotPermitted(
+                    "asset-transfer capability contract address, subject, code hash, or entrypoint mismatch"
+                        .to_owned(),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
