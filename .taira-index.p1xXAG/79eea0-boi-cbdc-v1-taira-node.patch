+                    id: "processor".to_owned(),
+                    attestor: source.clone(),
+                    predicate: AssetLockPredicate::TextEquals("i7".to_owned()),
+                    sequence: 1,
+                }),
+                AssetLockCondition::Oracle(AssetLockOracleCondition {
+                    id: "delivery_days".to_owned(),
+                    attestor: delivery_oracle.clone(),
+                    predicate: AssetLockPredicate::QuantityAtMost(Quantity::from(3_u32)),
+                    sequence: 2,
+                }),
+                AssetLockCondition::Within(AssetLockWithinCondition {
+                    id: "deadline".to_owned(),
+                    duration_ms: 7 * 86_400_000,
+                }),
+            ],
+            Vec::new(),
+        )
+        .execute(&source, &mut tx)
+        .expect("open conditional asset lock");
+
+        AttestAssetLockCondition::new(
+            escrow_id,
+            "processor",
+            AssetLockAttestationValue::Text("i7".to_owned()),
+            None,
+        )
+        .execute(&source, &mut tx)
+        .expect("attest processor condition");
+        let record = escrow_record(&tx, &escrow_id);
