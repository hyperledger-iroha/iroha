+    fn rebuild_asset_transfer_capability_indexes(&mut self) -> Result<(), String> {
+        let accounts = self.accounts.view();
+        let definitions = self.asset_definitions.view();
+        let contract_bindings = self.contract_subject_bindings.view();
+        let mut by_grantor = BTreeMap::<AccountId, BTreeSet<AssetTransferCapabilityIdV1>>::new();
+        let mut by_delegate = BTreeMap::<AccountId, BTreeSet<AssetTransferCapabilityIdV1>>::new();
+        let mut by_source = BTreeMap::<AssetId, BTreeSet<AssetTransferCapabilityIdV1>>::new();
+        let mut by_status = BTreeMap::<
+            AssetTransferCapabilityStatusV1,
+            BTreeSet<AssetTransferCapabilityIdV1>,
+        >::new();
+
+        for (capability_id, record) in self.asset_transfer_capabilities.view().iter() {
+            record.validate().map_err(|error| {
+                format!(
+                    "asset transfer capability {:?} is invalid: {error}",
+                    capability_id.as_hash()
+                )
+            })?;
+            if capability_id != &record.id {
+                return Err(format!(
+                    "asset transfer capability map key {:?} does not match record id {:?}",
+                    capability_id.as_hash(),
+                    record.id.as_hash()
+                ));
+            }
+            for (role, account) in [
+                ("grantor", &record.grantor),
+                ("delegate", &record.delegate),
+                ("destination", &record.destination),
+            ] {
+                if accounts.get(account).is_none() {
+                    return Err(format!(
+                        "asset transfer capability {:?} references missing {role} account {account}",
+                        capability_id.as_hash()
+                    ));
+                }
+            }
+            if definitions.get(record.source.definition()).is_none() {
+                return Err(format!(
+                    "asset transfer capability {:?} references missing definition {}",
+                    capability_id.as_hash(),
+                    record.source.definition()
+                ));
+            }
+            if let Some(scope) = &record.contract_scope {
+                let binding = contract_bindings.get(&scope.contract_address).ok_or_else(|| {
+                    format!(
+                        "asset transfer capability {:?} references an unknown contract address {}",
+                        capability_id.as_hash(),
+                        scope.contract_address
+                    )
+                })?;
+                if binding.subject != record.delegate
+                    || scope.contract_address.subject_id() != record.delegate
+                {
+                    return Err(format!(
+                        "asset transfer capability {:?} contract scope does not bind its delegate",
+                        capability_id.as_hash()
+                    ));
+                }
+            }
+            by_grantor
+                .entry(record.grantor.clone())
+                .or_default()
+                .insert(*capability_id);
+            by_delegate
+                .entry(record.delegate.clone())
+                .or_default()
+                .insert(*capability_id);
+            by_source
+                .entry(record.source.clone())
+                .or_default()
+                .insert(*capability_id);
+            by_status
+                .entry(record.status)
+                .or_default()
+                .insert(*capability_id);
+        }
+
+        self.asset_transfer_capabilities_by_grantor = by_grantor.into_iter().collect();
+        self.asset_transfer_capabilities_by_delegate = by_delegate.into_iter().collect();
+        self.asset_transfer_capabilities_by_source = by_source.into_iter().collect();
+        self.asset_transfer_capabilities_by_status = by_status.into_iter().collect();
+        Ok(())
+    }
