+fn ensure_exact_json_object_fields(
+    raw: &str,
+    context: &str,
+    required: &[&str],
+    optional: &[&str],
+) -> PyResult<()> {
+    let value = json::from_str::<json::Value>(raw)
+        .map_err(|error| PyValueError::new_err(format!("invalid {context} JSON: {error}")))?;
+    let json::Value::Object(fields) = value else {
+        return Err(PyValueError::new_err(format!(
+            "{context} JSON must be an object"
+        )));
+    };
+    let required = required.iter().copied().collect::<HashSet<_>>();
+    let allowed = required
+        .iter()
+        .copied()
+        .chain(optional.iter().copied())
+        .collect::<HashSet<_>>();
+    let observed = fields.keys().map(String::as_str).collect::<HashSet<_>>();
+    let mut unknown = observed.difference(&allowed).copied().collect::<Vec<_>>();
+    unknown.sort_unstable();
+    if !unknown.is_empty() {
+        return Err(PyValueError::new_err(format!(
+            "{context} JSON contains unknown fields: {}",
+            unknown.join(", ")
+        )));
+    }
+    let mut missing = required.difference(&observed).copied().collect::<Vec<_>>();
+    missing.sort_unstable();
+    if !missing.is_empty() {
+        return Err(PyValueError::new_err(format!(
+            "{context} JSON is missing required fields: {}",
+            missing.join(", ")
+        )));
+    }
+    Ok(())
+}
