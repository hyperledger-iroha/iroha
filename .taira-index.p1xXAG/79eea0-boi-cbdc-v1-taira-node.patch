+            "query_source": "indexed",
+        }
+
+    def call_contract_and_wait(self, **kwargs: Any) -> dict[str, Any]:
+        self.calls.append(("contract", kwargs))
+        return {
+            "tx_hashes": ["cc" * 32],
+            "terminal_kind": "Committed",
+            "r#final": {"status": {"kind": "Committed"}},
+        }
