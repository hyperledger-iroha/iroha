+def _identifier_require_exact_fields(
+    value: Any,
+    required: Iterable[str],
+    optional: Iterable[str],
+    context: str,
+) -> Mapping[str, Any]:
+    record = _require_mapping(value, context)
+    required_set = set(required)
+    allowed = required_set | set(optional)
+    missing = required_set - set(record)
+    unknown = set(record) - allowed
+    if missing:
+        raise ValueError(f"{context} is missing fields: {sorted(missing)}")
+    if unknown:
+        raise ValueError(f"{context} contains unknown fields: {sorted(unknown)}")
+    return record
+
+
+def _validate_identifier_receipt_shape(value: Any, context: str) -> Dict[str, Any]:
+    receipt = _identifier_require_exact_fields(
+        value, {"payload", "attestation"}, set(), context
+    )
+    payload = _identifier_require_exact_fields(
+        receipt["payload"],
+        {
+            "policy_id",
+            "execution",
+            "opening",
+            "opaque_id",
+            "receipt_hash",
+            "uaid",
+            "account_id",
+        },
+        set(),
+        f"{context}.payload",
+    )
+    _identifier_require_exact_fields(
+        payload["execution"],
+        {
+            "program_id",
+            "program_digest",
+            "backend",
+            "verification_mode",
+            "input_ciphertext_hash",
+            "output_ciphertext_hash",
+            "parameter_digest",
+            "evaluation_key_digest",
+            "output_hash",
+            "associated_data_hash",
+            "executed_at_ms",
+        },
+        {"expires_at_ms"},
+        f"{context}.payload.execution",
+    )
+    opening = _identifier_require_exact_fields(
+        payload["opening"],
+        {"payload", "signature"},
+        set(),
+        f"{context}.payload.opening",
+    )
+    _identifier_require_exact_fields(
+        opening["payload"],
+        {
+            "program_id",
+            "input_ciphertext_hash",
+            "output_ciphertext_hash",
+            "parameter_digest",
+            "evaluation_key_digest",
+            "opened_output_hash",
+            "opened_at_ms",
+        },
+        {"expires_at_ms"},
+        f"{context}.payload.opening.payload",
+    )
+    attestation = _require_mapping(receipt["attestation"], f"{context}.attestation")
+    kind = attestation.get("kind")
+    if kind == "signed":
+        _identifier_require_exact_fields(
+            attestation,
+            {"kind", "signature"},
+            set(),
+            f"{context}.attestation",
+        )
+    elif kind == "proof":
+        _identifier_require_exact_fields(
+            attestation,
+            {"kind", "proof_backend", "proof_b64"},
+            set(),
+            f"{context}.attestation",
+        )
+    else:
+        raise ValueError(f"{context}.attestation.kind must be signed or proof")
+    encode_identifier_resolution_receipt_payload(payload)
+    encode_identifier_resolution_receipt_attestation(attestation)
+    return dict(receipt)
