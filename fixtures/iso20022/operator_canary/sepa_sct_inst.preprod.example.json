{
  "provider": "sepa-sct-inst-operator",
  "environment": "preprod",
  "rail": {
    "inbox_dir": "sepa-sct-inst/inbox",
    "torii_base_url": "https://torii.sepa-sct-inst.operator-canary.bank",
    "receipt_dir": "sepa-sct-inst/receipts/rail",
    "dry_run": false,
    "allow_default_profile": false,
    "allow_insecure_http": false,
    "bearer_token_file": "sepa-sct-inst/secrets/torii.bearer",
    "max_payload_bytes": 4194304,
    "timeout_secs": 10
  },
  "notary": {
    "export_dir": "sepa-sct-inst/audit-export",
    "endpoints": [
      "https://notary.sepa-sct-inst.operator-canary.bank/iso-anchor"
    ],
    "receipt_dir": "sepa-sct-inst/receipts/notary",
    "all": false,
    "dry_run": false,
    "allow_insecure_http": false,
    "bearer_token_file": "sepa-sct-inst/secrets/notary.bearer",
    "timeout_secs": 10
  },
  "verify": {
    "enabled": true,
    "include_stage_receipts": true,
    "receipt_dirs": [],
    "receipts": [],
    "skip_on_stage_failure": true,
    "allow_failed": false,
    "allow_insecure_http": false,
    "allow_default_profile": false,
    "require_source_files": true
  }
}
