# Third-party dependencies for source-tree SDK tests on Python 3.12.
#
# `iroha-norito` and `iroha-torii-client` are imported from their sibling
# source trees in tests/conftest.py, so they intentionally do not appear here.
# Keep these ranges aligned with the local native, SDK, Norito, and Torii pyprojects.
#
# Regenerate from the repository root with Python 3.12 and pip-tools 7.6.2:
#   python3.12 -m piptools compile --generate-hashes --resolver=backtracking \
#     --strip-extras --allow-unsafe --output-file python/iroha_python/requirements-ci.lock \
#     python/iroha_python/requirements-ci.in

# pytest's Windows console dependency must remain pinned in the hashed CI gate.
colorama==0.4.6 ; sys_platform == "win32"
blake3==1.0.11
cryptography==50.0.2
maturin==1.15.0
pytest==9.2.0
requests==2.34.2
certifi==2026.10.23
urllib3==2.8.0

