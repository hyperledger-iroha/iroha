 fn snapshot_digest_v1(&self)->&[u8;32]{&self.0}
 fn slot_count_v1(&self)->u64{S_SLOTS_V1}
 fn plaintext_len_v1(&self)->u64{S_SLOT_BYTES_V1}
 fn ciphertext_record_len_v1(&self)->u64{S_SLOT_BYTES_V1+16}
