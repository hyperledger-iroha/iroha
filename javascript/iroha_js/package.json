{
  "name": "@iroha/iroha-js",
  "version": "0.0.3",
  "description": "Node.js SDK for interacting with Hyperledger Iroha via Norito payloads and Torii APIs.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./index.d.ts"
    },
    "./address": {
      "import": "./src/address.js",
      "types": "./index.d.ts"
    },
    "./browser": {
      "browser": "./src/browser.js",
      "import": "./src/browser.js",
      "types": "./index.d.ts"
    },
    "./privacy-capabilities": {
      "browser": "./src/privacyCapabilities.js",
      "import": "./src/privacyCapabilities.js",
      "types": "./privacy-capabilities.d.ts"
    },
    "./bootle-lantern-issuance": {
      "browser": "./src/bootleLanternIssuance.js",
      "import": "./src/bootleLanternIssuance.js",
      "types": "./bootle-lantern-issuance.d.ts"
    },
    "./transaction-codec": {
      "browser": "./src/transactionCodec.js",
      "import": "./src/transactionCodec.js",
      "types": "./transaction-codec.d.ts"
    },
    "./smart-contract-deployment": {
      "browser": "./src/smartContractDeployment.js",
      "import": "./src/smartContractDeployment.js",
      "types": "./smart-contract-deployment.d.ts"
    },
    "./normalizers": {
      "browser": "./src/normalizers.js",
      "import": "./src/normalizers.js",
      "types": "./index.d.ts"
    },
    "./blake2b": {
      "browser": "./src/blake2b.js",
      "import": "./src/blake2b.js",
      "types": "./index.d.ts"
    },
    "./ivm-artifact": {
      "browser": "./src/ivmArtifact.js",
      "import": "./src/ivmArtifact.js",
      "types": "./ivm-artifact.d.ts"
    },
    "./ivm-artifact-admission-wasm": {
      "browser": "./src/ivmArtifactAdmissionWasm.js",
      "import": "./src/ivmArtifactAdmissionWasm.js",
      "types": "./ivm-artifact-admission-wasm.d.ts"
    },
    "./instruction-builders": {
      "import": "./src/instructionBuilders.js",
      "types": "./index.d.ts"
    },
    "./torii": {
      "browser": "./src/toriiBrowserClient.js",
      "import": "./src/toriiClient.js",
      "types": "./index.d.ts"
    },
    "./torii-browser": {
      "import": "./src/toriiBrowserClient.js",
      "browser": "./src/toriiBrowserClient.js",
      "types": "./index.d.ts"
    },
    "./norito": {
      "import": "./src/norito.js",
      "types": "./index.d.ts"
    },
    "./canonical-request": {
      "browser": "./src/canonicalRequest.js",
      "import": "./src/canonicalRequest.js",
      "types": "./canonical-request.d.ts"
    },
    "./sccp": {
      "import": "./src/sccp.js",
      "types": "./index.d.ts"
    },
    "./sorafs": {
      "import": "./src/sorafs.js",
      "types": "./index.d.ts"
    },
    "./crypto": {
      "browser": "./src/crypto.browser.js",
      "import": "./src/crypto.js",
      "types": "./index.d.ts"
    },
    "./connect-browser": {
      "import": "./src/connect.browser.js",
      "types": "./connect.browser.d.ts"
    },
    "./nexus-app": {
      "browser": "./src/nexusApp.js",
      "import": "./src/nexusApp.js",
      "types": "./nexus-app.d.ts"
    },
    "./kotodama-compiler": {
      "types": "./kotodama-compiler.d.ts",
      "browser": "./src/kotodamaCompiler/browser.js",
      "import": "./src/kotodamaCompiler/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "address": [
        "./index.d.ts"
      ],
      "browser": [
        "./index.d.ts"
      ],
      "privacy-capabilities": [
        "./privacy-capabilities.d.ts"
      ],
      "bootle-lantern-issuance": [
        "./bootle-lantern-issuance.d.ts"
      ],
      "transaction-codec": [
        "./transaction-codec.d.ts"
      ],
      "smart-contract-deployment": [
        "./smart-contract-deployment.d.ts"
      ],
      "normalizers": [
        "./index.d.ts"
      ],
      "blake2b": [
        "./index.d.ts"
      ],
      "ivm-artifact": [
        "./ivm-artifact.d.ts"
      ],
      "ivm-artifact-admission-wasm": [
        "./ivm-artifact-admission-wasm.d.ts"
      ],
      "instruction-builders": [
        "./index.d.ts"
      ],
      "torii": [
        "./index.d.ts"
      ],
      "torii-browser": [
        "./index.d.ts"
      ],
      "norito": [
        "./index.d.ts"
      ],
      "canonical-request": [
        "./canonical-request.d.ts"
      ],
      "sccp": [
        "./index.d.ts"
      ],
      "sorafs": [
        "./index.d.ts"
      ],
      "crypto": [
        "./index.d.ts"
      ],
      "connect-browser": [
        "./connect.browser.d.ts"
      ],
      "nexus-app": [
        "./nexus-app.d.ts"
      ],
      "kotodama-compiler": [
        "./kotodama-compiler.d.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 src scripts recipes test --ext .js,.mjs",
    "lint:test": "npm run lint && npm test",
    "build:native": "node ./scripts/build-native.mjs && node ./scripts/copy-native.mjs",
    "build:dist": "node ./scripts/build-dist.mjs",
    "bundle:check": "node ./scripts/bundle-size-check.mjs",
    "test": "npm run build:native && node ./scripts/run-tests.mjs",
    "test:dist": "npm run build:dist && node ./scripts/run-tests.mjs",
    "test:pack-install": "node ./scripts/package-install-smoke.mjs",
    "check:changelog": "node ./scripts/check-changelog.mjs",
    "release:update-docs": "node ./scripts/update-release-docs.mjs",
    "release:provenance": "node ./scripts/record-release-provenance.mjs",
    "release:verify": "node ./scripts/verify-release-tarball.mjs",
    "fixtures:axt": "node ./scripts/refresh-axt-fixtures.mjs",
    "release:matrix": "node ./scripts/release-matrix.mjs",
    "release:publish": "npm publish --access public --provenance",
    "prepublishOnly": "npm run check:changelog && npm run build:dist && npm run lint:test && npm run bundle:check && npm run test:pack-install && npm run release:provenance",
    "test:integration": "node ./scripts/run_integration.mjs",
    "telemetry:capture": "node ./scripts/capture_sumeragi_telemetry.mjs",
    "report:bundle-size": "node ./scripts/report-bundle-size.mjs"
  },
  "keywords": [
    "iroha",
    "norito",
    "blockchain",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperledger-iroha/iroha.git",
    "directory": "javascript/iroha_js"
  },
  "bugs": {
    "url": "https://github.com/hyperledger-iroha/iroha/issues"
  },
  "homepage": "https://github.com/hyperledger-iroha/iroha/tree/master/javascript/iroha_js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.d.ts",
    "repo-agreement.d.ts",
    "privacy-capabilities.d.ts",
    "bootle-lantern-issuance.d.ts",
    "canonical-request.d.ts",
    "ivm-artifact.d.ts",
    "ivm-artifact-admission-wasm.d.ts",
    "transaction-codec.d.ts",
    "smart-contract-deployment.d.ts",
    "connect.browser.d.ts",
    "nexus-app.d.ts",
    "kotodama-compiler.d.ts",
    "package.json",
    "native/iroha_js_host.checksums.json",
    "dist",
    "recipes/iso_bridge_builder.mjs",
    "recipes/nexus_app_transfer.mjs",
    "scripts",
    "src"
  ],
  "browser": {
    "./src/authenticatedBlockProofs.js": "./src/authenticatedBlockProofs.browser.js",
    "./src/crypto.js": "./src/crypto.browser.js",
    "./src/cryptoHash.js": "./src/cryptoHash.browser.js",
    "./src/native.js": "./src/native.browser.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "private": false,
  "dependencies": {
    "@noble/ciphers": "^1.2.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.5.0",
    "@scure/bip39": "^2.2.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "esbuild": "0.28.1",
    "eslint": "^8.57.0",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
