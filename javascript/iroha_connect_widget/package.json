{
  "name": "@iroha/connect-widget",
  "version": "0.0.3",
  "description": "Drop-in IrohaConnect button and SORA Nexus sakura layer for web apps.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./sakura": {
      "types": "./sakura.d.ts",
      "import": "./src/sakura-element.js"
    },
    "./controller": {
      "types": "./controller.d.ts",
      "import": "./src/controller.js"
    },
    "./qr": {
      "types": "./qr.d.ts",
      "import": "./src/qr.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/index.js",
    "./src/sakura-element.js",
    "./dist/*.js"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "index.d.ts",
    "sakura.d.ts",
    "controller.d.ts",
    "qr.d.ts",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "lint": "eslint --max-warnings=0 src scripts test",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@iroha/iroha-js": "0.0.3"
  },
  "devDependencies": {
    "@iroha/iroha-js": "file:../iroha_js",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
