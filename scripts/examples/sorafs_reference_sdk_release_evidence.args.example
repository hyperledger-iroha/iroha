# Reviewed SF-11 reference SDK release evidence gate arguments.
# Point the evidence directory at the reviewed artifact root. Review only
# payload-free release summaries. Keep release signing keys, bearer tokens, raw
# archives, and operator secrets in runtime-only locations.
--evidence-dir /var/tmp/sorafs/reference-sdk-release
--summary-out /var/tmp/sorafs/reference-sdk-release/release-summary.json
--require-kind release_archive,signed_manifest,downstream_bindings,cookbook_smoke,ffi_header_contract,governance_approval
--now-unix 1800400000
--max-evidence-age-secs 1209600
--min-release-targets 5
--min-downstream-packages 6
--max-smoke-duration-secs 1800
