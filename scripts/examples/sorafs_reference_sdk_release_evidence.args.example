# Reviewed SF-11 reference SDK release evidence gate arguments.
# Point the evidence directory at the reviewed artifact root. Review only
# payload-free release summaries. Keep release signing keys, bearer tokens, raw
# archives, and operator secrets in runtime-only locations.
# Supply the reviewed deployment's supply-chain source root, public provenance
# trust tuple, and independently administered topology trust tuple for the same
# deployment context.
# Signed evidence must bind signing_provider=authenticated_external_signer and
# signing_backend=software; accepted output is software-key-qualified.
--evidence-dir /var/tmp/sorafs/reference-sdk-release
--summary-out /var/tmp/sorafs/reference-sdk-release/release-summary.json
--require-kind release_archive,signed_manifest,supply_chain,downstream_bindings,cookbook_smoke,ffi_header_contract,governance_approval
--now-unix 1800400000
--max-evidence-age-secs 1209600
--min-release-targets 5
--min-downstream-packages 6
--max-smoke-duration-secs 1800
--supply-chain-source-root /var/tmp/sorafs/reference-sdk-supply-chain-source
--provenance-certificate-identity https://github.com/hyperledger/iroha/.github/workflows/sorafs-cli-release.yml@refs/tags/sorafs-cli-v1.0.0
--provenance-oidc-issuer https://token.actions.githubusercontent.com
--provenance-verification-public-key-hex 1111111111111111111111111111111111111111111111111111111111111111
--topology-qualification-summary artifacts/sorafs/production-readiness/l1-topology-qualification.json
--topology-qualification-envelope artifacts/sorafs/production-readiness/l1-topology-qualification.envelope.json
--topology-qualification-verification-public-key-hex 2222222222222222222222222222222222222222222222222222222222222222
--topology-qualification-signer-service-id sorafs-production-topology-signer-a
--topology-qualification-signer-administrator-id sorafs-production-topology-admin-b
--topology-qualification-signer-key-revision 1
--topology-qualification-signer-policy-revision 1
--topology-qualification-signer-policy-digest-hex 3333333333333333333333333333333333333333333333333333333333333333
--max-topology-qualification-review-age-secs 1209600
