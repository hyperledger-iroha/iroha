# Example arguments for the SFM-4b moderation panel rollout evidence gate.
# Use runtime artifact locations; do not store secrets, raw evidence payloads,
# private commit/reveal payloads, response bodies, or ledgers.
--evidence-dir
artifacts/sorafs/moderation-panel/staged
--summary-out
artifacts/sorafs/moderation-panel/staged/rollout-summary.json
--require-kind
appeal_intake,sortition_roster,evidence_viewer,operator_workflow,juror_notifications,commit_reveal,decision_publication,settlement_integration,transparency_reputation,e2e_panel,metrics_alerts,governance_approval
--now-unix
1800400000
--max-canary-age-secs
86400
--max-event-lag-secs
900
--max-route-latency-ms
1500
--min-panel-size
7
--min-peers
4
--topology-qualification-summary artifacts/sorafs/production-readiness/l1-topology-qualification.json
