# Example arguments for the SFM-2 orderbook rollout evidence collection planner.
# Supply reviewed, payload-free staged evidence paths. Run with:
#   python3 scripts/run_sorafs_orderbook_rollout_evidence.py @scripts/examples/sorafs_orderbook_rollout_collection.args.example --dry-run
--out-dir
artifacts/sorafs/orderbook/staged
--summary-out
artifacts/sorafs/orderbook/staged/rollout-summary.json
--max-evidence-age-secs
604800
