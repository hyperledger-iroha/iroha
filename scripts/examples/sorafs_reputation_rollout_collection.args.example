# Example arguments for the SFM-3 reputation rollout evidence collection planner.
# Run with:
#   python3 scripts/run_sorafs_reputation_rollout_evidence.py \
#     @scripts/examples/sorafs_reputation_rollout_collection.args.example \
#     --dry-run
#
# Keep signing keys, bearer tokens, raw snapshots, proof bytes, and operator
# secrets in runtime-only locations. This example stores only paths and
# payload-free rollout summaries in the repository-local artifacts/ directory.
# Generated and supplied evidence must include reviewed deployment context:
# generated_at_unix, deployment_id, environment, and deployment_context_reviewed.

--sorafs-cli-bin
target/debug/sorafs_cli
--torii-url
https://validator.example.invalid
# Set this to the deployment's exact canonical single-key I105 account. Keep
# the matching key file runtime-only, regular, single-linked, owner-readable
# only, and at a path whose parents are not symlinks.
--auth-account
sorauﾛ1NｲﾘｳdPBeｼRoｸQ2ﾔgｼQqeｶﾍｽﾁhRW2ｺｿZ9ﾕｦUﾅRX5NJYH53
--auth-private-key-file
/runtime/sorafs/reputation/reader.key
--snapshot
/runtime/sorafs/reputation/reputation-snapshot.to
--publish-evidence
/runtime/sorafs/reputation/reputation-publication-canary.json
# Provider ids are exact 1..=256-byte ASCII values from [A-Za-z0-9_.:-];
# the whole values "." and ".." are reserved URL dot segments and are rejected.
--provider-id
provider-a
--provider-proof
provider-a=/runtime/sorafs/reputation/provider-a-proof.to
--metrics-evidence
/runtime/sorafs/reputation/reputation-metrics-canary.json
--transport-evidence
/runtime/sorafs/reputation/reputation-transport-canary.json
--consumption-evidence
/runtime/sorafs/reputation/reputation-consumption-canary.json
--out-dir
artifacts/sorafs/reputation/staged
--summary-out
artifacts/sorafs/reputation/staged/rollout-summary.json
--now-unix
1800400000
--max-snapshot-age-secs
691200
--max-ingest-lag-secs
900
--watch-since
0
--watch-limit
100
--watch-max-polls
1
--watch-poll-interval-ms
1000
