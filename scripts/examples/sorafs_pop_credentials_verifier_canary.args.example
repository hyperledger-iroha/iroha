# Reviewed verifier-service canary inputs for the SFM-4b1 PoP credential gate.
--kind verifier_service
--out artifacts/sorafs/pop/verifier-service-canary.json
--deployment-id sorafs-pop-prod-20260701
--environment production
--generated-at-unix 1800100000
--now-unix 1800100000
--root-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--revocation-list-digest-hex bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
--policy-digest-hex dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
--route proof_verify
--route proof_status
--route health
--accepted-valid-proof-count 1
--accepted-proof-probe valid-proof-00
--rejected-invalid-proof-count 3
--rejected-proof-probe invalid-proof-00
--rejected-proof-probe invalid-proof-01
--rejected-proof-probe invalid-proof-02
--max-verify-latency-ms 250
--max-service-lag-seconds 20
--verified-claim expired_proof_rejected
--verified-claim revoked_proof_rejected
--verified-claim replay_nullifier_rejected
--verified-claim root_binding_verified
