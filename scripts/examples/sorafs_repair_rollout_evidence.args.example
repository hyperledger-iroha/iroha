# Example arguments for the SF-8b repair rollout evidence gate.
# Use runtime artifact locations; do not store secrets, raw PoR or PoTR
# evidence, signed auditor requests, repair payloads, response bodies, signed
# transactions, or ledgers.
--evidence-dir
artifacts/sorafs/repair/staged
--summary-out
artifacts/sorafs/repair/staged/rollout-summary.json
--max-evidence-age-secs
604800
--max-route-latency-ms
1500
--max-event-lag-secs
900
--max-repair-latency-secs
7200
--min-auditors
3
