# Copy to a runtime evidence directory and replace every angle-bracket value.
# The signature input is exactly 64 raw Ed25519 bytes exported by the HSM.
finalize
--topology-qualification-summary artifacts/sorafs/production-readiness/l1-topology-qualification.json
--signing-payload artifacts/sorafs/production-readiness/foundational-signing-payload.bin
--signature-file artifacts/sorafs/production-readiness/foundational-signature.bin
--trusted-public-key-hex <TRUSTED-ED25519-PUBLIC-KEY-HEX>
--expected-deployment-id <REVIEWED-PRODUCTION-DEPLOYMENT-ID>
--expected-environment production
--expected-release-sequence <MONOTONIC-RELEASE-SEQUENCE>
--expected-previous-envelope-sha256 <PREVIOUS-ENVELOPE-SHA256>
# For release sequences after 1, add:
# --previous-envelope <EXACT-PREVIOUS-FINALIZED-ENVELOPE>
--now-unix <REVIEWED-VALIDATOR-UNIX>
--max-evidence-age-secs 1209600
--envelope-out artifacts/sorafs/production-readiness/foundational-prerequisites.json
