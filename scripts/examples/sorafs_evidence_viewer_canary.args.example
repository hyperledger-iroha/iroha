# Payload-free SoraFS SFM-4b3 evidence-viewer canary builder inputs.
# Fill digest values from reviewed deployment evidence digests; do not place
# raw evidence, signed URLs, session tokens, access logs, legal-hold bodies, or
# watermark secrets in this file.
--out dist/sorafs-evidence-viewer-canary/evidence-viewer.json
--deployment-id sorafs-panel-prod-20260701
--environment production
--generated-at-unix 1800100000
--now-unix 1800100000
--case-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--roster-hash-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--session-count 3
--attested-session-count 3
--logged-session-count 3
--max-url-ttl-secs 300
--role juror
--role auditor
--role legal_reviewer
--security-control strict_csp
--security-control offline_mode_disabled
--security-control short_lived_urls
--security-control role_scoped_manifest
--security-control watermark_overlay
--access-event-kind view
--access-event-kind seek
--access-event-kind pause
--access-event-kind screenshot_attempt
--access-event-kind download_attempt
--access-event-kind annotation
--export-target governance_dag
--export-target transparency_ledger
--verified-claim attested_viewer_enabled
--verified-claim role_scoped_manifest_verified
--verified-claim short_lived_urls_verified
--verified-claim session_key_workflow_verified
--verified-claim strict_csp_enforced
--verified-claim offline_mode_disabled
--verified-claim per_session_access_logged
--verified-claim append_only_log_verified
--verified-claim anomaly_events_recorded
--verified-claim watermark_overlay_rendered
--verified-claim watermark_metadata_hashed
--verified-claim audit_digest_exported
--verified-claim transparency_report_exported
--verified-claim daily_digest_published
--verified-claim payload_redaction_verified
--verified-claim denylisted_digest_blocked
--verified-claim unauthorized_access_rejected
--verified-claim stale_url_rejected
--verified-claim session_replay_rejected
--verified-claim legal_hold_policy_bound
--session-manifest-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--watermark-metadata-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--access-log-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--legal-hold-receipt-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--transparency-report-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--audit-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
