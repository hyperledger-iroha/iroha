# Copy to a runtime evidence directory and replace every angle-bracket value.
# This checked-in example is intentionally non-runnable and contains no key.
prepare
--topology-qualification-summary artifacts/sorafs/production-readiness/l1-topology-qualification.json
--topology-qualification-envelope artifacts/sorafs/production-readiness/l1-topology-qualification.envelope.json
--topology-qualification-verification-public-key-hex <TRUSTED-TOPOLOGY-ED25519-PUBLIC-KEY-HEX>
--topology-qualification-signer-service-id <TOPOLOGY-SOFTWARE-SIGNER-SERVICE-ID>
--topology-qualification-signer-administrator-id <TOPOLOGY-SIGNER-ADMINISTRATOR-ID>
--topology-qualification-signer-key-revision <POSITIVE-TOPOLOGY-KEY-REVISION>
--topology-qualification-signer-policy-revision <POSITIVE-TOPOLOGY-POLICY-REVISION>
--topology-qualification-signer-policy-digest-hex <NONZERO-TOPOLOGY-POLICY-SHA256>
--max-topology-qualification-review-age-secs 1209600
--resilience-qualification-summary artifacts/sorafs/production-readiness/l1-resilience-qualification.json
--resilience-qualification-signer-public-key-hex <TRUSTED-RESILIENCE-ED25519-PUBLIC-KEY-HEX>
--l1-lane-evidence-inventory artifacts/sorafs/production-readiness/l1-lane-evidence.inventory
--l1-lane-evidence-inventory-verification-public-key-hex <TRUSTED-L1-INVENTORY-ED25519-PUBLIC-KEY-HEX>
--l1-lane-evidence-inventory-signer-service-id <L1-INVENTORY-SOFTWARE-SIGNER-SERVICE-ID>
--l1-lane-evidence-inventory-signer-administrator-id <L1-INVENTORY-SIGNER-ADMINISTRATOR-ID>
--l1-lane-evidence-inventory-signer-key-revision <POSITIVE-L1-INVENTORY-KEY-REVISION>
--l1-lane-evidence-inventory-signer-policy-revision <POSITIVE-L1-INVENTORY-POLICY-REVISION>
--l1-lane-evidence-inventory-signer-policy-digest-sha256 <NONZERO-L1-INVENTORY-POLICY-SHA256>
--deployment-id <REVIEWED-PRODUCTION-DEPLOYMENT-ID>
--environment production
--generated-at-unix <REVIEWED-ENVELOPE-UNIX>
--now-unix <REVIEWED-VALIDATOR-UNIX>
--max-evidence-age-secs 1209600
--release-sequence <MONOTONIC-RELEASE-SEQUENCE>
--previous-envelope-sha256 <PREVIOUS-ENVELOPE-SHA256>
# For release sequences after 1, add:
# --previous-envelope <EXACT-PREVIOUS-FINALIZED-ENVELOPE>
--trusted-public-key-hex <TRUSTED-ED25519-PUBLIC-KEY-HEX>
--signer-service-id <EXTERNAL-SOFTWARE-SIGNER-SERVICE-ID>
--signer-administrator-id <INDEPENDENT-SIGNER-ADMINISTRATOR-ID>
--signer-key-revision <POSITIVE-SIGNER-KEY-REVISION>
--signer-policy-revision <POSITIVE-SIGNER-POLICY-REVISION>
--signer-policy-digest-sha256 <NONZERO-SIGNER-POLICY-SHA256>
--prerequisite SFM-1=<SFM-1-EVIDENCE-PACKAGE-MANIFEST-JSON>
