# Copy to a runtime evidence directory and replace every angle-bracket value.
# This checked-in example is intentionally non-runnable and contains no key.
prepare
--topology-qualification-summary artifacts/sorafs/production-readiness/l1-topology-qualification.json
--deployment-id <REVIEWED-PRODUCTION-DEPLOYMENT-ID>
--environment production
--generated-at-unix <REVIEWED-ENVELOPE-UNIX>
--now-unix <REVIEWED-VALIDATOR-UNIX>
--max-evidence-age-secs 1209600
--release-sequence <MONOTONIC-RELEASE-SEQUENCE>
--previous-envelope-sha256 <PREVIOUS-ENVELOPE-SHA256>
# For release sequences after 1, add:
# --previous-envelope <EXACT-PREVIOUS-FINALIZED-ENVELOPE>
--trusted-public-key-hex <TRUSTED-ED25519-PUBLIC-KEY-HEX>
--prerequisite SFM-1:<SFM-1-EVIDENCE-SHA256>:<SFM-1-EVIDENCE-UNIX>
--prerequisite SF-1:<SF-1-EVIDENCE-SHA256>:<SF-1-EVIDENCE-UNIX>
--prerequisite SF-2:<SF-2-EVIDENCE-SHA256>:<SF-2-EVIDENCE-UNIX>
--prerequisite SF-2c:<SF-2C-EVIDENCE-SHA256>:<SF-2C-EVIDENCE-UNIX>
--prerequisite SF-3:<SF-3-EVIDENCE-SHA256>:<SF-3-EVIDENCE-UNIX>
--prerequisite SF-4:<SF-4-EVIDENCE-SHA256>:<SF-4-EVIDENCE-UNIX>
--prerequisite SF-5b:<SF-5B-EVIDENCE-SHA256>:<SF-5B-EVIDENCE-UNIX>
--prerequisite SF-6:<SF-6-EVIDENCE-SHA256>:<SF-6-EVIDENCE-UNIX>
--prerequisite SF-8a:<SF-8A-EVIDENCE-SHA256>:<SF-8A-EVIDENCE-UNIX>
--lane-summary ai_prescreen=<AI-PRESCREEN-READY-SUMMARY-JSON>
--lane-summary appeal_finance=<APPEAL-FINANCE-READY-SUMMARY-JSON>
--lane-summary gateway_compliance=<GATEWAY-COMPLIANCE-READY-SUMMARY-JSON>
--lane-summary gateway_load=<GATEWAY-LOAD-READY-SUMMARY-JSON>
--lane-summary governance_dag=<GOVERNANCE-DAG-READY-SUMMARY-JSON>
--lane-summary hedging_billing=<HEDGING-BILLING-READY-SUMMARY-JSON>
--lane-summary moderation_panel=<MODERATION-PANEL-READY-SUMMARY-JSON>
--lane-summary orderbook=<ORDERBOOK-READY-SUMMARY-JSON>
--lane-summary pdp=<PDP-READY-SUMMARY-JSON>
--lane-summary pop_credentials=<POP-CREDENTIALS-READY-SUMMARY-JSON>
--lane-summary por=<POR-READY-SUMMARY-JSON>
--lane-summary potr=<POTR-READY-SUMMARY-JSON>
--lane-summary reference_sdk_release=<REFERENCE-SDK-RELEASE-READY-SUMMARY-JSON>
--lane-summary repair=<REPAIR-READY-SUMMARY-JSON>
--lane-summary reputation=<REPUTATION-READY-SUMMARY-JSON>
--lane-summary reserve_rent=<RESERVE-RENT-READY-SUMMARY-JSON>
--lane-summary transparency=<TRANSPARENCY-READY-SUMMARY-JSON>
--signing-payload-out artifacts/sorafs/production-readiness/foundational-signing-payload.bin
