# Example arguments for the production SFM-4c transparency rollout evidence
# collection planner.
# Run with:
#   python3 scripts/run_sorafs_transparency_rollout_evidence.py \
#     @scripts/examples/sorafs_transparency_rollout_collection.args.example \
#     --dry-run
#
# Keep signing keys, bearer tokens, raw source-entry payloads, proof-token
# frames, response bodies, and operator secrets in runtime-only files. This
# example passes only the path to a runtime client config and payload-free
# canary request files. The reserved .example origin is shape-only; use the
# operator-reviewed production origin for a genuine collection.

--iroha-bin
iroha
--iroha-arg=--config
--iroha-arg=/runtime/sorafs/production/transparency-client.toml
--torii-url
https://transparency.sorafs.example
--deployment-id
sorafs-mainnet-2026-07
--environment
production
--out-dir
artifacts/sorafs/transparency/production
--summary-out
artifacts/sorafs/transparency/production/rollout-summary.json
--now-unix
1800400000
--max-evidence-age-secs
604800
--limit
50
--timeout-secs
30
--source-entry
gar-enforcement-receipt=/runtime/sorafs/production/transparency/gar.json
--source-entry
moderation-ballot-governance-event=/runtime/sorafs/production/transparency/moderation-ballot.json
--source-entry
appeal-finance-report=/runtime/sorafs/production/transparency/appeal-report.json
--source-entry
appeal-finance-settlement-receipt=/runtime/sorafs/production/transparency/appeal-settlement.json
--source-entry
legal-hold-notice=/runtime/sorafs/production/transparency/legal-hold.json
--source-entry
redaction-notice=/runtime/sorafs/production/transparency/redaction.json
--source-entry
evidence-access-summary=/runtime/sorafs/production/transparency/evidence-access.json
--privacy-source-event
/runtime/sorafs/production/transparency/privacy-source-event.json
--privacy-publish-due
/runtime/sorafs/production/transparency/privacy-publish-due.json
--proof-token-issuance
/runtime/sorafs/production/transparency/proof-token-issuance.json
--cycle-id
4f1d2c3b5a69788796a5b4c3d2e1f0aa
--topology-qualification-summary
artifacts/sorafs/production-readiness/l1-topology-qualification.json
