# Reviewed finalized-projection observability inputs for the SFM-2 orderbook gate.
--kind observability
--out artifacts/sorafs/orderbook/staged/observability-canary.json
--deployment-id sorafs-orderbook-prod-20260701
--environment production
--generated-at-unix 1800100000
--now-unix 1800100000
--contract-digest-hex aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
--metrics-scraped-at-unix 1800100000
--finalized-projection-height 42
--finalized-projection-timestamp-seconds 1800100000
--finalized-projection-failure-delta 0
--metric torii_sorafs_orderbook_finalized_events_total
--metric torii_sorafs_orderbook_open_depth_gib
--metric torii_sorafs_orderbook_matcher_lag_seconds
--metric torii_sorafs_orderbook_settlement_backlog
