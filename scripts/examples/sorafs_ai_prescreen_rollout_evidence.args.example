# Example:
#   python3 scripts/check_sorafs_ai_prescreen_rollout_evidence.py \
#     @scripts/examples/sorafs_ai_prescreen_rollout_evidence.args.example
#
# Review only payload-free rollout summaries. Keep runner payloads, bearer
# tokens, signing keys, raw manifest bytes, and operator secrets in
# runtime-only locations.

--evidence-dir
dist/sorafs-ai-prescreen-rollout-evidence
--summary-out
dist/sorafs-ai-prescreen-rollout-evidence/rollout-summary.json
--require-kind
runner,committee,operator_workflow,notification_transport,commit_reveal_executor,transparency_publication,governance_dag,end_to_end_workflow
--now-unix
1800400000
--max-evidence-age-secs
604800
--topology-qualification-summary artifacts/sorafs/production-readiness/l1-topology-qualification.json
