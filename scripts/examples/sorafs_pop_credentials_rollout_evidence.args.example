# Example:
#   python3 scripts/check_sorafs_pop_credentials_rollout_evidence.py \
#     @scripts/examples/sorafs_pop_credentials_rollout_evidence.args.example
#
# Keep signing keys, credentials, holder identities, and raw proofs out of these
# evidence files. The checker accepts payload-free canary summaries only.

--evidence-dir
dist/sorafs-pop-credentials-rollout-evidence
--summary-out
dist/sorafs-pop-credentials-rollout-evidence/rollout-summary.json
--now-unix
1800006000
--max-root-age-secs
604800
--max-revocation-age-secs
86400
--max-service-lag-secs
900
--max-verify-latency-ms
1000
