+// x/net v0.60.0 refuses invalid IDNA input instead of replacing invalid UTF-8.
+func TestNormalizeHTTPHostRejectsInvalidIDNA(t *testing.T) {
+	for _, host := range []string{"\x94.EXAMPLE.COM", "\ufffd.EXAMPLE.COM"} {
+		normalized, err := normalizeHTTPHost(&url.URL{Scheme: "https", Host: host})
+		require.ErrorContains(t, err, "invalid http host")
+		require.Empty(t, normalized)
 	}
 }
 
