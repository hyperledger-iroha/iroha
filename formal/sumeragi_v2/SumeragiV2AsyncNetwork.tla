  \A node \in ValidatorIds:
    /\ AsyncStrongTypeInvariant
    /\ DeferredQueueNonempty(node)
    /\ ~DeferredHandoffActive(node)
    => AsyncCandidateLifecycleOrdinal(NextDeferredCommand(node))
         = OldestDeferredHeadLifecycleOrdinal(node)
