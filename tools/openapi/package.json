    "check:openapi-versions": "node scripts/verify-openapi-versions.mjs",
    "test": "node --test scripts/__tests__/sync-openapi.test.mjs scripts/__tests__/verify-openapi-versions.test.mjs scripts/__tests__/verify-musubi-v1-contract.test.mjs scripts/__tests__/check-openapi-signatures.test.mjs scripts/__tests__/openapi-manifest-v2.test.mjs scripts/__tests__/openapi-release-inputs.test.mjs scripts/__tests__/openapi-release-contract.test.mjs scripts/__tests__/openapi-safe-file.test.mjs scripts/__tests__/provision-openapi-cargo-lock.test.mjs scripts/__tests__/openapi-signature.test.mjs"
