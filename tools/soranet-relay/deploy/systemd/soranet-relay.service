[Unit]
Description=SoraNet relay daemon
Requires=network-online.target
After=network-online.target

[Service]
User=soranet
Group=soranet
EnvironmentFile=-/etc/soranet/relay/relay.env
StateDirectory=soranet-relay
StateDirectoryMode=0700
LogsDirectory=soranet
LogsDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/test ! -L /var/lib/soranet-relay/audit-spool
ExecStartPre=/usr/bin/test ! -L /var/lib/soranet-relay/guard-pinning-proofs
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/soranet-relay/audit-spool /var/lib/soranet-relay/guard-pinning-proofs
ExecStart=/usr/local/bin/soranet-relay --config /etc/soranet/relay/relay.json
Restart=on-failure
RestartSec=5s
LimitNOFILE=131072
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
