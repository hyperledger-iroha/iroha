// Representative trigger and localization sample for Kotodama grammar validation.
seiyaku TreasurySweep {
    error enum SweepError {
        EmptyTreasury = 1,
    }

    state LastSweepHeight: i64;
    hajimari() {
        LastSweepHeight = 0;
    }

    trigger settle_block -> sweep {
        on pipeline block;
        repeats 1;
        authority "sorauﾛ1Npﾃﾕヱﾇq11pｳﾘ2ｱ5ﾇｦiCJKjRﾔzｷNMNﾆｹﾕPCｳﾙFvｵE9LBLB";
        metadata {
            tag: "treasury";
            enabled: true;
        }
    }

    kotoage fn sweep() authorize("Admin") {
        let balance = 1_000_000;
        require(balance > 0, SweepError::EmptyTreasury);
        LastSweepHeight = LastSweepHeight + 1;
        debug::info("treasury_swept");
    }
}
