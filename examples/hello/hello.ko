// Minimal Kotodama example: logs a greeting and writes a detail for the current authority
seiyaku Hello {
    // Optional initializer; deploy-oriented runtimes may call this automatically.
    hajimari() {
        debug::info("Hello from Kotodama");
    }

    // Named public entrypoint; callers must select `main` explicitly.
    kotoage fn main() authorize("Admin") {
        debug::info("Hello from Kotodama");
        write_detail();
    }

    // Public entrypoint that sets an account detail on the caller.
    kotoage fn write_detail() authorize("Admin") {
        ledger::account::set_detail(context::authority(), Name::parse("example"), Json::parse("{\"hello\":\"world\"}"));
    }
}
