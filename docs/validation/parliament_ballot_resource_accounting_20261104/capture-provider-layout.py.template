paths={Path(__file__),work/'Cargo.toml',work/'Cargo.lock',work/'src/lib.rs',root/'Cargo.toml',root/'Cargo.lock',root/'rust-toolchain.toml'}
for pkg in metadata['packages']:
 d=Path(pkg['manifest_path']).parent;paths.add(d/'Cargo.toml');paths.update(d.rglob('*.rs'))
 for f in ('Cargo.toml.orig','.cargo-checksum.json'):
  if (d/f).exists():paths.add(d/f)
