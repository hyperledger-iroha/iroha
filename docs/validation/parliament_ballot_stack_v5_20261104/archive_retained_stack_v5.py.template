#!/usr/bin/env python3
"""Archive the separately accepted stack-v5 diagnostic without touching prior evidence."""
from datetime import datetime, timezone
import gzip
import hashlib
import json
from pathlib import Path


def digest(data):
    return hashlib.sha256(data).hexdigest()


def write_json(path, value):
    path.write_text(json.dumps(value, sort_keys=True, indent=2) + '\n')


def main():
    root = Path('/Users/takemiyamakoto/dev/iroha')
    cache = Path('/Users/takemiyamakoto/Library/Caches/iroha-script-tests/runs/parliament-current-20261104')
    source = cache / 'stack-v5'
    destination = root / 'docs/validation/parliament_ballot_stack_v5_20261104'
    receipt_bytes = (source / 'receipt.json').read_bytes()
    receipt = json.loads(receipt_bytes)
    assert receipt['capture_passed'] is True and receipt['failure'] is None
    assert not receipt['input_changes'] and not receipt['original_capture_changes']
    assert set(receipt['captures']) == {'portable', 'accel'}
    original_pins = receipt['original_captures_sha256_after']
    assert original_pins == receipt['original_captures_sha256_before']
    for path, expected in {**receipt['input_sha256_after'], **original_pins}.items():
        assert digest(Path(path).read_bytes()) == expected, path
    destination.mkdir(parents=True, exist_ok=False)
    retained = []
    for path in sorted(source.rglob('*')):
        if not path.is_file():
            continue
        data = path.read_bytes()
        relative = path.relative_to(source)
        compressed = relative.name in {'portable.json', 'accel.json', 'disassembly.txt'}
        target = destination / (str(relative) + ('.gz' if compressed else ''))
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(gzip.compress(data, mtime=0) if compressed else data)
        archived = target.read_bytes()
        assert (gzip.decompress(archived) if compressed else archived) == data
        retained.append({'original_path': str(path), 'original_sha256': digest(data),
                         'archived_path': str(target.relative_to(destination)),
                         'archived_sha256': digest(archived), 'gzip': compressed})
    assert (source / 'receipt.json').read_bytes() == receipt_bytes
    for mode, capture in receipt['captures'].items():
        assert digest((source / (mode + '.json')).read_bytes()) == capture['sha256']
        assert digest(Path(capture['exact_obligation_comparison']['path']).read_bytes()) == capture['exact_obligation_comparison']['sha256']
        assert capture['whole_image_frame_error_count'] == 1
        assert capture['whole_image_ordinary_frame_error_count'] == 0
        assert all(row['complete_stack_bound_bytes'] is None for row in capture['roots'])
        assert all(capture['v4_raw_bytes_identical'].values())
    reference = cache / 'stack-v3-reference/download.json'
    (destination / 'arm-reference-download.json').write_bytes(reference.read_bytes())
    (destination / 'archive_retained_stack_v5.py.template').write_bytes(Path(__file__).read_bytes())
    write_json(destination / 'independent-review.json', {
        'schema': 'parliament-stack-v5-independent-review-record-v1',
        'recorded_utc': datetime.now(timezone.utc).isoformat(),
        'reviewer': '/root/state_runner_finish',
        'method': 'Independent read-only inspection in the shared workspace; no reviewer edits or test execution.',
        'analyzer_sha256': receipt['input_sha256_before'][str(root / 'scripts/parliament_ballot_stack_audit.py')],
        'tests_sha256': receipt['input_sha256_before'][str(root / 'scripts/tests/parliament_ballot_stack_audit_test.py')],
        'driver_sha256': receipt['input_sha256_before'][str(cache / 'capture_retained_stack_v5.py')],
        'implementation_review': 'Exact complete interval, full image and range binding, SP alignment and known effects, no name/native-cost assumptions, no transitive returnability, and preserved call/depth/callee obligations reviewed.',
        'findings_closed': [
            'All removed baseline merges must remain active deferred refusals, including a positive stack-growing loop after an omitted continuation. Fixed and covered by adversarial regression.',
            'Whole-image error headline must include deferred frame errors. Active counter is retained; separate ordinary-only counter added.',
            'Capture before pins must still match reviewed helpers and parsed receipt bytes. Before pins are rechecked; build/triage/reference are parsed from retained byte buffers bound to those pins.',
        ],
        'qualification_uplift': False,
        'scope': 'Implementation, adversarial controls and capture driver review; capture results remain independently inspectable through exact comparison artifacts.',
    })
    summary = {
        'schema': 'parliament-retained-image-stack-v5-summary-v1',
        'observed_utc': receipt['observed_utc'],
        'scope': receipt['scope'],
        'capture_passed': True,
        'analyzer_tests_passed': 244,
        'all_ten_complete_stack_bounds_unknown': True,
        'captures': receipt['captures'],
        'retained_files': retained,
        'original_v2_v3_v4_and_diagnosis_files_unchanged': len(original_pins),
        'all_eight_raw_outputs_byte_identical_to_v4': True,
        'exact_v4_obligations_preserved_with_addresses_depths_and_sccs': True,
        'no_build_or_worker_execution': True,
        'latest_source_build_validated': False,
        'historical_evidence_rebound': False,
        'complete_stack_certificate': False,
        'complete_workspace_certificate': False,
        'physical_cost_calibrated': False,
        'profile_qualified': False,
        'release_qualified': False,
        'limitations': [
            'Only ordinary ABI control flow is refined. Every original physical/resource refusal stays machine-active.',
            'The Shape merge has an ordinary-return-path explanation but remains an active deferred stack refusal.',
            'Native endpoint costs, traps, indirect targets, positive recursion, function fallthroughs, hidden exception/signal/unwind paths and memory aliases remain unresolved.',
            'Resolved-region figures remain conditional on the analyzer ABI assumptions and are not physical complete stack bounds.',
            'Latest-source qualification remains unavailable: prior review found rustup/Cargo.lock drift against the retained build.',
            'Historical 160-node suite remains 47 passed and 113 failed; no historical evidence was repinned.',
            'Binary/tool/reference bytes remain in guarded cache paths, which are not permanent release custody.',
        ],
    }
    write_json(destination / 'summary.json', summary)
    readme = '''# Parliament retained-image stack-v5 diagnostic

The bounded no-ordinary-return rule refines ordinary control flow in both retained
November 4 worker images. **All ten complete stack bounds remain `null`. Every
v4 call and frontier retains its exact original address and caller depth; the
resource graph and positive-weight recursive components remain unchanged.** This
is artifact-bound static evidence, with no qualification uplift.

The rule requires a complete, contiguous, aligned interval between two exact
`LC_FUNCTION_STARTS` entries. Before its first UDF/BRK, the interval permits only
known-effect exact straight-line mnemonics and direct BL calls to known function
or native-stub entries. SP must remain known, nonpositive and 16-byte aligned.
After that terminal instruction, only decoded UDF/BRK padding is accepted.
The final function, missing words, malformed operands, unknown stack effects,
RET, branches, indirect calls, HLT, dotted prefixes and non-trap trailing words
refuse a fact. Facts bind the exact interval plus full disassembly, starts,
stubs, binary, tool and analyzer identities. They are rederived before use.

Direct calls may return only under the existing ordinary ABI assumption. There
is no symbol-name inference, native cost assignment or transitive fixed point.
The caller retains its call edge and depth; terminal callees retain their full
conservative analysis. Only the impossible ordinary continuation is omitted.
Every removed baseline call or frontier remains machine-active through deferred
obligations, including native `__Unwind_Resume`, traps, function fallthroughs,
recursive calls and inconsistent-SP merges. Deferred frontiers prevent complete
bounds. Original maximum frame decrements are preserved.

Each image yields 25 facts and 151 omitted ordinary continuations. Six internal
calls per image remain active as deferred calls. The ordinary-only frame-error
count is zero, while the active frame-error count remains one: the Shape merge.
Its ordinary-CFG explanation is separate from its retained resource refusal.
The [prior read-only diagnosis](../parliament_ballot_shape_merge_20261104/README.md)
and [v4 capture](../parliament_ballot_stack_v4_20261104/README.md) are unchanged.

| Deferred frontier | Portable | Accelerated |
| --- | ---: | ---: |
| Function fallthrough | 36 | 34 |
| Exceptional terminal | 42 | 44 |
| Native edge | 5 | 5 |
| Inconsistent SP merge | 1 | 1 |

These are ordinary-to-deferred classifications, not discharged obligations.
The complete per-function before/after mapping, responsible facts and omitted
call sites are in [portable-v4-comparison.json](portable-v4-comparison.json) and
[accel-v4-comparison.json](accel-v4-comparison.json). Every function is checked
against its exact v4 baseline; all original calls and frontiers are conserved as
multisets with original depths. All five roots per image retain identical
frontiers, positive-weight SCCs and direct resource reachability.

| Selected root | Portable region, bytes | Accelerated region, bytes | Complete bound |
| --- | ---: | ---: | --- |
| `Reservation::verify` | 15,808 | 12,864 | Unknown |
| `workspace::worker` | 16,000 | 13,056 | Unknown |
| `fatal::exhausted` | 144 | 144 | Unknown |
| Registration proof verifier | 9,744 | 6,800 | Unknown |
| Vote proof verifier | 9,744 | 6,800 | Unknown |

These unchanged region figures are ordinary-ABI conditional diagnostics. Native
costs, indirect targets, trap handling, positive recursion, hidden unwind,
exception and signal paths and memory aliases remain unresolved. The fatal
prefix retains its 16-byte frame, modeled 128-byte red zone, native exit and
possible UDF continuation. There is no all-input or whole physical stack bound.

Primary terminal semantics: [Arm DDI 0602, 2025-03](https://documentation-service.arm.com/static/67e40f3398aa3c3b6eea6a85),
printed pages 90 (BRK) and 1056 (UDF). The retained reference identity is in
[arm-reference-download.json](arm-reference-download.json).

The focused suite passes **244 tests**. New controls cover exact ranges and
identity changes, missing/misaligned instructions, malformed terminals, all
rejected control transfers, invalid SP/FP states, recursion and non-propagation,
and active retention of deferred native, trap, fallthrough, recursive and merge
obligations. The positive-stack-loop adversary retains its original merge at
`0x1004` and depth 16 after an omitted continuation. `git diff --check` passes
for the analyzer and tests. The [independent review](independent-review.json)
records the preservation and initial-pinning findings and their fixes.

The [capture driver](capture_retained_stack_v5.py.template) guards reviewed
helper identities, exact parsed receipt bytes, retained binary and LLVM tool
hashes, and every prior capture/diagnosis file before and after. All eight raw
LLVM outputs equal v4 byte for byte. No Rust build, worker execution, timing
campaign or historical-suite rerun was performed. Latest-source qualification
remains separate because the prior review observed rustup/Cargo.lock drift.
The historical 160-node suite remains 47 passed and 113 failed.

[summary.json](summary.json) maps archived bytes to their original cache paths
and hashes. Large mode JSON and disassembly files use lossless deterministic
gzip; exact comparison JSON is directly readable. `SHA256SUMS` covers every file
here except itself. Binary, tool and reference bytes remain in the persistent
cache, which is not permanent release custody. No historical capture was repinned.
'''
    (destination / 'README.md').write_text(readme)
    for path, expected in original_pins.items():
        assert digest(Path(path).read_bytes()) == expected, path
    write_json(destination / 'archive-check.json', {
        'original_capture_and_diagnosis_files_rechecked': len(original_pins),
        'all_unchanged': True,
        'capture_receipt_sha256': digest(receipt_bytes),
        'archive_driver_sha256': digest(Path(__file__).read_bytes()),
        'all_compressed_copies_roundtripped': True,
    })
    files = [path for path in sorted(destination.rglob('*')) if path.is_file()]
    (destination / 'SHA256SUMS').write_text(''.join(digest(path.read_bytes()) + '  ' + str(path.relative_to(destination)) + '\n' for path in files))
    print(json.dumps({'archive': str(destination), 'files': len(files) + 1,
                      'summary_sha256': digest((destination / 'summary.json').read_bytes()),
                      'manifest_sha256': digest((destination / 'SHA256SUMS').read_bytes())}))


if __name__ == '__main__':
    main()
