    <2>4. UNCHANGED <<context, asyncHeldChunks>>
      BY <1>1, <2>1, Isa
         DEF ExecuteSignTimeout, CompleteTimeoutSignature, vars
    <2>5. /\ AsyncRuntimeScalarTypeInvariant
