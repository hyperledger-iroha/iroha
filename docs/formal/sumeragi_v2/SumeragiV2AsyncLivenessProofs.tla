FifoDiscardSerializedStep(node) ==
  LET command == NextNodeCommand(node)
  IN /\ RemoveNextNodeCommand(node)
     /\ DiscardCommand(command)
     /\ LeaveCausalQueues
     /\ UNCHANGED <<asyncDeferredCompletionQueues,
