           /\ CurrentVoters \subseteq ValidatorIds
      BY <1>1, RuntimeCurrentVotersAreFiniteValidators
         DEF AsyncTypeInvariant
    <2>2. /\ IsFiniteSet(Items)
           /\ Cardinality(Items) <= Cardinality(CurrentVoters)
      BY <2>1, FS_Image
