FifoRuntimeSelected(node) ==
  /\ ~asyncDeferredDrainOwed[node]
  /\ ~DeferredTagExecutable(node)
  /\ ~TimeoutDue(node)
  /\ NodeQueueNonempty(node)
  /\ (asyncFifoOwed[node] \/ ~RetransmitDue(node))

