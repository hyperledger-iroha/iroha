BY IsaM("blast")
   DEF RunHistoricalServer, DrainHistoricalIngressSelected,
       HistoricalIdleStep, AsyncRecoveryScheduledVars,
       AsyncDeferredVars

THEOREM AsyncFaultStepLeavesRecoveryScheduledVars ==
