    /\ \/ \E node \in AsyncCurrentResponsiveVoters: ServiceIoWorker(node)
       \/ \E node \in asyncHistoricalRecoveryTargets:
              ServiceHistoricalRecoveryIoWorker(node)
       \/ \E node \in AsyncCurrentResponsiveVoters:
