  /\ AsyncStrongTypeInvariant
  /\ AsyncRecoveryReplayingPending
  => ENABLED <<ResponsiveReplayRunNode>>_AsyncAllVars
BY ResponsiveUnappliedRunNodeIsEnabled, ExpandENABLED, Isa
