             /\ ResponsiveProtectedServeJobOwned(node, job)
             => \E position \in Nat:
                  ProtectedServeOwnedAtServiceRank(
                    node, job, <<5, position>>))
    BY <1>1, Isa
  <1> QED BY <1>2

