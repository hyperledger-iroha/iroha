{
  "title": "Taikai Cache Observability",
  "uid": "taikai-cache",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": [
    "taikai",
    "cache",
    "sn13"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Cache hit ratio (5m)",
      "description": "Share of Taikai cache queries served from any cache tier over the last five minutes.",
      "id": 1,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(sorafs_taikai_cache_query_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(sorafs_taikai_cache_query_total[5m])), 1e-9)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cache query outcomes (per minute)",
      "description": "Five-minute query rate converted to outcomes per minute and grouped by result and serving tier.",
      "id": 2,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "60 * sum by (result, tier) (rate(sorafs_taikai_cache_query_total[5m]))",
          "legendFormat": "{{result}}/{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "1/min",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cache byte throughput",
      "description": "Bytes inserted or served per second, grouped by cache event and tier.",
      "id": 3,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (event, tier) (rate(sorafs_taikai_cache_bytes_total[5m]))",
          "legendFormat": "{{event}}/{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cache inserts (per minute)",
      "description": "Five-minute insert rate converted to events per minute and grouped by destination tier.",
      "id": 4,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "60 * sum by (tier) (rate(sorafs_taikai_cache_insert_total[5m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "1/min",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Cache evictions (per minute)",
      "description": "Five-minute eviction rate converted to events per minute and grouped by tier and reason.",
      "id": 5,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "60 * sum by (tier, reason) (rate(sorafs_taikai_cache_evictions_total[5m]))",
          "legendFormat": "{{tier}}/{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "1/min",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Cache promotions (per minute)",
      "description": "Five-minute promotion rate converted to events per minute and grouped by source and destination tier.",
      "id": 6,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "60 * sum by (from_tier, to_tier) (rate(sorafs_taikai_cache_promotions_total[5m]))",
          "legendFormat": "{{from_tier}} → {{to_tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "1/min",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "QoS denials (per minute)",
      "description": "Five-minute Taikai QoS denial rate converted to events per minute and grouped by class.",
      "id": 7,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "60 * sum by (class) (rate(sorafs_taikai_qos_denied_total[5m]))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "1/min",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "showPoints": "never"
      }
    },
    {
      "type": "timeseries",
      "title": "Open shard circuits",
      "description": "Current open circuit breakers in the Taikai pull queue grouped by shard id.",
      "id": 8,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sorafs_taikai_shard_circuits_open",
          "legendFormat": "shard {{shard}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "showPoints": "never"
      }
    },
    {
      "type": "timeseries",
      "title": "Shard failovers (rate)",
      "description": "Five-minute rate of shard failovers observed by the Taikai pull queue.",
      "id": 9,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (preferred_shard, selected_shard) (rate(sorafs_taikai_shard_failovers_total[5m]))",
          "legendFormat": "{{preferred_shard}} → {{selected_shard}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "showPoints": "never"
      }
    },
    {
      "type": "timeseries",
      "title": "Taikai queue depth",
      "description": "Current Taikai pull queue backlog grouped by state.",
      "id": 10,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sorafs_taikai_queue_depth",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "showPoints": "never"
      }
    },
    {
      "type": "timeseries",
      "title": "Taikai queue events (5m rate)",
      "description": "Five-minute rate of queue events grouped by event/class (issued, hedged, rate-limited, backpressure).",
      "id": 11,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (event, class) (rate(sorafs_taikai_queue_events_total[5m]))",
          "legendFormat": "{{event}} ({{class}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        },
        "showPoints": "never"
      }
    }
  ]
}
